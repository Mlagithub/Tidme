title: $:/plugins/tidme/manager/styles
type: text/vnd.tiddlywiki
tags: [[$:/tags/Stylesheet]]

/* Tidme Manager：卡片浏览 / 管理器 / 牌组批量操作样式 */

/* 卡片浏览（侧边栏树形） */
.tm-card-browser details {
	margin-left: 0.4em;
}
.tm-card-browser summary {
	cursor: pointer;
}
.tm-cb-deck {
	margin-top: 0.4em;
}
.tm-cb-doc {
	margin-left: 0.6em;
}
.tm-cb-doc-title {
	opacity: 0.85;
	font-size: 0.95em;
}
.tm-cb-card {
	display: flex;
	align-items: center;
	gap: 0.3em;
	font-size: 0.9em;
	padding: 1px 0;
}
.tm-cb-badge {
	font-size: 0.85em;
	opacity: 0.8;
	min-width: 1.2em;
}
.tm-cb-kind {
	font-size: 0.8em;
	opacity: 0.6;
}
.tm-cb-link {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	max-width: 16em;
}
.tm-cb-del {
	opacity: 0.4;
	padding: 0 4px;
}
.tm-cb-del:hover {
	opacity: 1;
}

/* 卡片管理器 */
.tm-card-manager {
	font-size: 0.95em;
}
.tm-cm-views {
	display: flex;
	gap: 0.4em;
	flex-wrap: wrap;
	margin-bottom: 0.3em;
}
.tm-cm-view {
	padding: 2px 10px;
	border-radius: 4px;
	border: 1px solid <<colour muted-foreground>>;
	opacity: 0.85;
}
.tm-cm-view-active {
	background: <<colour primary>>;
	color: <<colour background>>;
	opacity: 1;
}
.tm-cm-orgs {
	display: flex;
	gap: 0.4em;
	flex-wrap: wrap;
	margin-bottom: 0.3em;
}
.tm-cm-org {
	padding: 1px 8px;
	border-radius: 3px;
	border: 1px dashed <<colour muted-foreground>>;
	opacity: 0.75;
	font-size: 0.9em;
}
.tm-cm-org:hover {
	opacity: 1;
}
.tm-cm-org-active {
	border-style: solid;
	border-color: <<colour primary>>;
	color: <<colour primary>>;
	opacity: 1;
}
.tm-cm-bar {
	display: flex;
	gap: 0.4em;
	flex-wrap: wrap;
	align-items: center;
	margin-bottom: 0.5em;
	padding: 4px 0;
	border-top: 1px dotted <<colour muted-foreground>>;
	border-bottom: 1px dotted <<colour muted-foreground>>;
}
.tm-cm-bar button {
	padding: 1px 8px;
	font-size: 0.9em;
}
.tm-cm-tree details {
	margin-left: 0.4em;
}
.tm-cm-tree summary {
	cursor: pointer;
}
.tm-cm-deck {
	margin-top: 0.4em;
}
.tm-cm-doc {
	margin-left: 0.6em;
}
.tm-cm-doc-title {
	opacity: 0.85;
	font-size: 0.95em;
}
.tm-cm-card {
	display: flex;
	align-items: center;
	gap: 0.35em;
	padding: 2px 0;
}
.tm-cm-head {
	border-bottom: 1px dotted <<colour muted-foreground>>;
	margin-bottom: 2px;
	font-size: 0.85em;
	opacity: 0.8;
}
.tm-cm-head-cell {
	min-width: 2em;
}
.tm-cm-sort {
	padding: 0 4px;
	font-size: 0.9em;
	border-radius: 3px;
	border: 1px solid transparent;
}
.tm-cm-sort:hover {
	border-color: <<colour muted-foreground>>;
}
.tm-cm-sort-active {
	border-color: <<colour primary>>;
	color: <<colour primary>>;
}
.tm-cm-listrow {
	font-size: 0.9em;
}
.tm-cm-col-deck {
	font-size: 0.8em;
	opacity: 0.6;
	min-width: 6em;
	max-width: 10em;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.tm-cm-col-due {
	font-size: 0.8em;
	opacity: 0.6;
	min-width: 5em;
}
/* 卡片信息列（对标 SuperMemo Element data） */
.tm-cm-col-info {
	font-size: 0.8em;
	opacity: 0.65;
	min-width: 4em;
}
.tm-cm-preview {
	margin: 6px 0 2px;
	padding: 6px 8px;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 4px;
	background: <<colour very-light-background>>;
}
.tm-cm-preview-head {
	font-size: 0.85em;
	opacity: 0.8;
	margin-bottom: 3px;
}
.tm-cm-preview-body {
	font-size: 0.9em;
	max-height: 10em;
	overflow: auto;
	white-space: pre-wrap;
}
/* 卡片信息明细（对标 Element data 分组） */
.tm-cm-info-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(11em, 1fr));
	gap: 2px 12px;
	font-size: 0.85em;
	margin: 3px 0;
}
.tm-cm-info-grid span {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.tm-cm-info-label {
	opacity: 0.55;
	margin-right: 0.4em;
}
/* 单卡参数编辑（对标 Element parameters） */
.tm-cm-edit {
	margin: 4px 0 2px;
	padding: 4px 8px;
	border: 1px dashed <<colour muted-foreground>>;
	border-radius: 4px;
	font-size: 0.9em;
}
.tm-cm-edit-row {
	display: flex;
	align-items: center;
	gap: 0.5em;
	margin: 3px 0;
	flex-wrap: wrap;
}
.tm-cm-edit-row input[type="text"],
.tm-cm-edit-row input[type="number"] {
	width: 12em;
}
.tm-cm-orphan summary strong {
	opacity: 0.65;
	font-style: italic;
}
.tm-cm-badge {
	font-size: 0.85em;
	min-width: 1.3em;
	text-align: center;
	border-radius: 3px;
	padding: 0 2px;
}
.tm-badge-new { background: #dbeafe; }
.tm-badge-learn { background: #fef3c7; }
.tm-badge-due { background: #d1fae5; }
.tm-badge-overdue { background: #fee2e2; }
.tm-badge-done { background: #e5e7eb; opacity: 0.8; }
.tm-badge-suspended { background: #ede9fe; }
.tm-cm-kind {
	font-size: 0.8em;
	opacity: 0.6;
}
.tm-cm-pri {
	font-size: 0.75em;
	opacity: 0.5;
}
.tm-cm-link {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	max-width: 18em;
}
.tm-cm-op {
	padding: 0 5px;
	font-size: 0.85em;
	opacity: 0.7;
}
.tm-cm-op:hover {
	opacity: 1;
}
.tm-cm-del:hover {
	color: <<colour danger>>;
}

title: $:/plugins/tidme/manager/styles
type: text/vnd.tiddlywiki
tags: [[$:/tags/Stylesheet]]

/* Tidme Manager：卡片浏览 / 管理器 / 牌组批量操作样式 */

/* 设计 token / tm-btn 基类统一由 $:/plugins/tidme/core/styles/tokens 提供 */
/* ===== 按钮：tm-btn 基类与变体统一由 core/styles/tokens 提供；此处仅图标尺寸 ===== */
.tm-btn-icon { padding: 2px 6px; }
.tm-btn-icon img, .tm-btn-icon svg { width: 1em; height: 1em; vertical-align: -0.15em; }

/* ===== 空状态（tm-empty：图标 + 说明 + 可选主操作） ===== */
.tm-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--tm-gap);
	padding: 18px 8px;
	color: <<colour muted-foreground>>;
	font-size: 0.9em;
	text-align: center;
}
.tm-empty-icon { font-size: 1.8em; opacity: 0.45; line-height: 1; }

/* ===== Toast 反馈（P3 接入写库动作；tm-notify 通知模板的自定义样式） ===== */
.tm-toast {
	padding: 6px 12px;
	border-radius: var(--tm-radius);
	border: 1px solid <<colour muted-foreground>>;
	background: <<colour background>>;
	font-size: 0.9em;
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
}
.tm-toast--ok { border-color: #22c55e; color: #15803d; }
.tm-toast--err { border-color: <<colour danger>>; color: <<colour danger>>; }

/* 卡片浏览（侧边栏树形） */
.tm-card-browser details {
	margin-left: 0.4em;
}
.tm-card-browser summary {
	cursor: pointer;
}
.tm-cb-deck {
	margin-top: 0.4em;
}
.tm-cb-doc {
	margin-left: 0.6em;
	padding-left: 0.5em;
	border-left: 2px solid <<colour muted-foreground>>;
	opacity: 0.9;
}
.tm-cb-doc-title {
	opacity: 0.85;
	font-size: 0.95em;
}
.tm-cb-card {
	display: flex;
	align-items: center;
	gap: 0.3em;
	font-size: 0.9em;
	padding: 1px 0;
}
.tm-cb-badge {
	font-size: 0.85em;
	opacity: 0.8;
	min-width: 1.2em;
}
.tm-cb-kind {
	font-size: 0.8em;
	opacity: 0.6;
}
.tm-cb-link {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	max-width: 16em;
}
.tm-cb-del {
	opacity: 0.4;
	padding: 0 4px;
}
.tm-cb-del:hover {
	opacity: 1;
}

/* 卡片管理器 */
.tm-card-manager {
	font-size: 0.95em;
}
.tm-cm-toolbar {
	position: sticky;
	top: 0;
	z-index: 60;
	background: var(--tm-surface);
	padding: 8px 0 10px;
	margin-bottom: 6px;
	border-bottom: 1px solid var(--tm-border);
	box-shadow: 0 2px 8px rgba(17, 24, 39, 0.05);
}
.tm-cm-views {
	display: flex;
	gap: 0.5em;
	flex-wrap: wrap;
	margin-bottom: 8px;
}
.tm-cm-view {
	padding: 2px 10px;
	border-radius: var(--tm-radius-sm);
	border: 1px solid var(--tm-border);
	background: var(--tm-surface);
	color: var(--tm-text-2);
}
.tm-cm-view-active {
	background: var(--tm-accent);
	border-color: var(--tm-accent);
	color: #fff;
}
.tm-cm-orgs {
	display: flex;
	gap: 0.5em;
	flex-wrap: wrap;
	margin-bottom: 12px;
}
.tm-cm-org {
	padding: 1px 8px;
	border-radius: var(--tm-radius-sm);
	border: 1px dashed var(--tm-border);
	background: var(--tm-surface);
	color: var(--tm-text-2);
	font-size: 0.9em;
}
.tm-cm-org:hover {
	color: var(--tm-text-1);
}
.tm-cm-org-active {
	border-style: solid;
	border-color: var(--tm-accent);
	color: var(--tm-accent);
	background: var(--tm-accent-soft);
}
.tm-cm-bar {
	display: flex;
	gap: 0.5em;
	flex-wrap: wrap;
	align-items: center;
	margin-bottom: 12px;
	padding: 10px 0;
	border-top: 1px solid var(--tm-border);
	border-bottom: 1px solid var(--tm-border);
}
.tm-cm-bar button {
	font-size: 0.85em;
}
.tm-cm-tree details {
	margin-left: 0.4em;
}
.tm-cm-tree summary {
	cursor: pointer;
}
.tm-cm-deck {
	margin-top: 0.4em;
}
.tm-cm-doc {
	margin-left: 0.8em;
	padding-left: 0.5em;
	border-left: 2px solid var(--tm-border);
}
.tm-cm-doc-title {
	font-weight: 600;
	font-size: 0.95em;
}
.tm-cm-card {
	display: flex;
	align-items: center;
	gap: 0.35em;
	padding: 2px 0;
}
.tm-cm-head {
	border-bottom: 1px dotted <<colour muted-foreground>>;
	margin-bottom: 2px;
	font-size: 0.85em;
	opacity: 0.8;
}
.tm-cm-head-cell {
	min-width: 2em;
}
.tm-cm-sort {
	padding: 0 4px;
	font-size: 0.9em;
	border-radius: 3px;
	border: 1px solid transparent;
}
.tm-cm-sort:hover {
	border-color: <<colour muted-foreground>>;
}
.tm-cm-sort-active {
	border-color: <<colour primary>>;
	color: <<colour primary>>;
}
.tm-cm-listrow {
	font-size: 0.9em;
}
.tm-cm-col-deck {
	font-size: 0.8em;
	opacity: 0.6;
	min-width: 6em;
	max-width: 10em;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.tm-cm-col-due {
	font-size: 0.8em;
	opacity: 0.6;
	min-width: 5em;
}
/* 卡片信息列（对标 SuperMemo Element data） */
.tm-cm-col-info {
	font-size: 0.8em;
	opacity: 0.65;
	min-width: 4em;
}
/* 卡片列表真表格（P2） */
.tm-cm-table {
	border-collapse: collapse;
	width: 100%;
	font-size: 0.92em;
}
.tm-cm-table th,
.tm-cm-table td {
	border-bottom: 1px solid <<colour muted-foreground>>;
	padding: 2px 6px;
	text-align: left;
	vertical-align: middle;
}
.tm-cm-table thead th {
	position: sticky;
	top: 0;
	background: <<colour background>>;
	opacity: 0.9;
	font-weight: 500;
	z-index: 1;
	white-space: nowrap;
}
.tm-cm-table tbody tr:hover td {
	background: <<colour very-light-background>>;
}
.tm-cm-table tbody tr.tm-cm-listrow-selected td {
	background: <<colour very-light-background>>;
}
.tm-cm-cell-cb {
	width: 2em;
	text-align: center;
}
.tm-cm-cell-flex {
	display: flex;
	align-items: center;
	gap: 0.35em;
}
.tm-cm-listrow {
	cursor: pointer;
}

.tm-cm-preview {
	margin: 6px 0 2px;
	padding: 6px 8px;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 4px;
	background: <<colour very-light-background>>;
}
.tm-cm-preview-head {
	font-size: 0.85em;
	opacity: 0.8;
	margin-bottom: 3px;
}
.tm-cm-preview-body {
	font-size: 0.9em;
	max-height: 10em;
	overflow: auto;
	white-space: pre-wrap;
}
/* 卡片信息明细（对标 Element data 分组） */
.tm-cm-info-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(11em, 1fr));
	gap: 2px 12px;
	font-size: 0.85em;
	margin: 3px 0;
}
.tm-cm-info-grid span {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.tm-cm-info-label {
	opacity: 0.55;
	margin-right: 0.4em;
}
/* 单卡参数编辑（对标 Element parameters） */
.tm-cm-edit {
	margin: 4px 0 2px;
	padding: 4px 8px;
	border: 1px dashed <<colour muted-foreground>>;
	border-radius: 4px;
	font-size: 0.9em;
}
.tm-cm-edit-row {
	display: flex;
	align-items: center;
	gap: 0.5em;
	margin: 3px 0;
	flex-wrap: wrap;
}
.tm-cm-edit-row input[type="text"],
.tm-cm-edit-row input[type="number"] {
	width: 12em;
}
/* 牌组批量操作卡片（P2） */
.tm-queue-card {
	border: 1px solid <<colour muted-foreground>>;
	border-radius: var(--tm-radius);
	padding: 6px 10px;
	margin: 6px 0;
	background: <<colour background>>;
}
.tm-queue-card-head {
	display: flex;
	align-items: baseline;
	gap: var(--tm-gap-lg);
	margin-bottom: 4px;
}
.tm-queue-card-count {
	font-size: 0.85em;
	opacity: 0.65;
}
.tm-queue-card-btns {
	display: flex;
	gap: var(--tm-gap);
	flex-wrap: wrap;
}

.tm-cm-orphan summary strong {
	opacity: 0.65;
	font-style: italic;
}
.tm-cm-badge {
	font-size: 0.85em;
	min-width: 1.3em;
	text-align: center;
	border-radius: 3px;
	padding: 0 2px;
}
.tm-badge-new { background: var(--tm-badge-new); }
.tm-badge-learn { background: var(--tm-badge-learn); }
.tm-badge-due { background: var(--tm-badge-due); }
.tm-badge-overdue { background: var(--tm-badge-overdue); }
.tm-badge-done { background: var(--tm-badge-done); opacity: 0.8; }
.tm-badge-suspended { background: var(--tm-badge-suspended); }
.tm-cm-kind {
	font-size: 0.8em;
	opacity: 0.6;
}
.tm-cm-pri {
	font-size: 0.75em;
	opacity: 0.5;
}
.tm-cm-link {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	max-width: 18em;
}
.tm-cm-op {
	padding: 0 5px;
	font-size: 0.85em;
	opacity: 0.7;
}
.tm-cm-op:hover {
	opacity: 1;
}
.tm-cm-del:hover {
	color: <<colour danger>>;
}

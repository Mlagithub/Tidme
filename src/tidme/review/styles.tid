tags: $:/tags/Stylesheet
title: $:/plugins/keepone/tidme/review/styles.css
type: text/css

.tmc-thead{
    display:flex;
    justify-content: space-between;
    align-items:center;
    font-weight: bold;
    border-bottom: 1px solid <<colour table-border>>;
    padding-bottom:10px;
}

.tmc-tr{
    display:flex;
    justify-content: space-between;
    align-items:center;
    padding:10px 0;
}

.tmc-tr .tmc-button-show{
    margin: 0 3px !important;
    flex-shrink: 0;
}

.tmc-tr .tmc-button-hide{
    opacity: 0;
    margin: 0 3px !important;
    flex-shrink: 0;
}

.tmc-tr:hover {
    background-color: <<colour page-background>>;
}

.tmc-tr:hover .tmc-button-hide{
    opacity: 1 !important;
}

.tmc-tr-deck{
    flex:0 1 40%;
    display: flex;
    justify-content:flex-start;
}


.tmc-tr-study{
    flex:0 1 15%;
    display: flex;
    justify-content:center;
}

.tmc-tr-action{
    flex:0 1 15%;
    display: flex;
    justify-content:flex-end;
}



.tmc-btn-primary {
    background: <<colour primary>>;
    color: <<colour background>>;
    fill: <<colour background>>;
}

.tmc-btn-dirty {
    background: <<colour dirty-indicator>>;
    color: <<colour background>>;
    fill: <<colour background>>;
}

.tmc-btn-dirty {
    background: <<colour dirty-indicator>>;
    color: <<colour background>>;
    fill: <<colour background>>;
}

/* 复习评分条：sticky 顶部固定，长卡片评分随手可点 */
.tmc-study-bar {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--tm-surface);
    padding: 4px 0 6px;
    border-bottom: 1px solid var(--tm-border);
}
.tmc-study-count { font-size: 10px; color: var(--tm-text-2); }

.tmc-repeat-wrapper {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 10px;
	margin: 16px 0 10px;
	width: 100%;
}
.tmc-repeat-wrapper button {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 10px 8px;
	border-radius: var(--tm-radius-sm) !important;
	border: 1px solid var(--tm-border) !important;
	background: var(--tm-surface) !important;
	box-shadow: var(--tm-shadow-sm);
	cursor: pointer;
	text-decoration: none !important;
	transition: var(--tm-transition) !important;
	width: 100%;
}
.tmc-repeat-wrapper button:hover {
	transform: translateY(-2px);
	box-shadow: var(--tm-shadow-md);
	border-color: currentColor !important;
	background: var(--tm-surface-2) !important;
}

.tmc-repeat-wrapper-1 {
	display: flex;
	justify-content: center;
	margin-top: 16px;
}

.tmc-decks-button-wrapper{
    display:flex;
    justify-content: space-around;
    align-items: baseline;
}

.tmc-file-input-wrapper {
    position: relative;
    overflow: hidden;
    vertical-align: middle;
}

.tmc-file-input-wrapper input[type=file] {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    font-size: 999px;
    max-width: 100%;
    max-height: 100%;
    filter: alpha(opacity=0);
    opacity: 0;
    outline: none;
    background: white;
    cursor: pointer;
    display: inline-block;
}

.tmc-title-hide ~ .tc-tiddler-title .tc-title{
    color: <<colour tiddler-background>> !important;
    font-size: {{$:/themes/tiddlywiki/vanilla/metrics/bodyfontsize}} !important;
}

.tmc-title-hide ~ .tc-tiddler-title .tc-title .tc-system-title-prefix{
    color: <<colour tiddler-background>> !important;
    font-size: {{$:/themes/tiddlywiki/vanilla/metrics/bodyfontsize}} !important;
}

.tmc-hideinput input{
    display: block;
    outline: none;
    border: none;
    width:100%;
    text-align:center;
    color:grey;
    font-size:9px;
}

.tmc-text-sg {
	font-size: 0.78em;
	font-weight: 550;
	color: var(--tm-text-3);
	margin-top: 2px;
}

/* ===== $:/Decks 工作流中心（复用 core 设计系统的 tm-* 组件） ===== */
.tm-decks { display: flex; flex-direction: column; gap: 16px; }
.tm-decks-head { padding-bottom: 12px; }
.tm-decks-title { font-size: 1.5em; font-weight: 700; letter-spacing: -0.01em; color: var(--tm-text-1); }
.tm-decks-top { display: flex; align-items: center; justify-content: space-between; }
.tm-theme-toggle { display: inline-flex; }
.tm-theme-toggle .tm-btn { font-size: 0.8em; padding: 4px 12px; }
.tm-decks-actions { display: flex; gap: 10px; margin: 14px 0 8px; }
.tm-workflow-btn { font-size: 0.92em; padding: 8px 18px; border-radius: var(--tm-radius-sm); }
.tm-workflow-btn .tm-btn-icon { width: 1.1em; height: 1.1em; }
.tm-decks-sub { font-size: 0.86em; color: var(--tm-text-2); margin-top: 2px; }
.tm-decks-nav { font-size: 0.86em; margin-top: 6px; color: var(--tm-text-2); }
.tm-decks-nav a { margin-right: 0.7em; }

/* 牌组列表（tiddlywiki-plugin 的 tmc-* 行）现代化：卡片悬浮流 */
.tm-decks .tmc-thead {
	display: flex;
	justify-content: space-between;
	align-items: center;
	font-weight: 600;
	color: var(--tm-text-3);
	font-size: 0.8em;
	text-transform: uppercase;
	letter-spacing: 0.04em;
	padding: 0 20px 8px;
	border-bottom: none;
}
.tm-decks .tmc-tr {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 15px 20px;
	margin-bottom: 12px;
	background: var(--tm-surface);
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	box-shadow: var(--tm-shadow-sm);
	transition: var(--tm-transition);
}
.tm-decks .tmc-tr:hover {
	background: var(--tm-surface);
	border-color: hsl(245, 75%, 85%);
	transform: translateY(-2px);
	box-shadow: var(--tm-shadow-lg);
}
.tm-decks .tmc-tr-deck {
	flex: 0 1 40%;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	gap: 8px;
	font-weight: 600;
	font-size: 0.96em;
}
.tm-decks .tmc-tr-study {
	flex: 0 1 15%;
	display: flex;
	justify-content: center;
	align-items: center;
}
.tm-decks .tmc-tr-action {
	flex: 0 1 15%;
	display: flex;
	justify-content: flex-end;
}
.tm-decks .tmc-tr-study .tm-badge {
	font-size: 0.85em;
	padding: 3px 10px;
	font-weight: 600;
	min-width: 44px;
	border-radius: 999px;
	text-align: center;
	transition: var(--tm-transition);
	border: 1px solid transparent;
}
.tm-decks .tmc-tr-study .tm-badge:hover {
	transform: scale(1.06);
	box-shadow: var(--tm-shadow-sm);
}

.tm-decks .tmc-decks-button-wrapper {
	display: flex;
	justify-content: flex-start;
	gap: 12px;
	align-items: center;
	margin-top: 14px;
}

/* ===== 牌组详情细节 (Deck Details Capsule Counts) ===== */
.tm-deck-details {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 16px 20px;
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	background: var(--tm-surface-2);
	margin-top: 14px;
}
.tm-deck-counts {
	display: flex;
	gap: 10px;
}
.tm-deck-counts .tm-badge {
	font-size: 0.88em;
	padding: 4px 12px;
	font-weight: 600;
}
.tm-deck-study-actions {
	display: flex;
	gap: 8px;
}

/* ===== 复习进度条细节高亮 (Review progress highlight) ===== */
.tmc-study-count {
	display: flex;
	gap: 6px;
	align-items: center;
}
.tmc-study-count .tm-badge {
	font-size: 0.76em;
	padding: 2px 8px;
	min-width: 2.2em;
	text-align: center;
	font-weight: 700;
	border: 1px solid transparent;
}
.tmc-study-count .tm-badge-active {
	border-color: currentColor;
	box-shadow: 0 0 5px currentColor;
}
.tmc-btn-again, .tmc-btn-hard, .tmc-btn-good, .tmc-btn-easy {
	font-size: 1.1em;
	font-weight: 700;
	line-height: 1.3;
}

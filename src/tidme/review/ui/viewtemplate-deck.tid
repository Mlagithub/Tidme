title: $:/plugins/keepone/tidme/review/ui/ViewTemplate/deck
tags: $:/tags/ViewTemplate
list-before: $:/core/ui/ViewTemplate/body
code-body: yes
<!-- 过滤器组合唯一真源 = core/deck-engine；模板只经 deckfilter 操作符取字符串再 subfilter 求值。
     曾经本文件与 ViewTemplate/tiddler 各复制一份 $let 组合，改动单侧即静默漂移（队列错一半看不出来）。
     两条仍在模板侧成立的铁律（真实 TW 踩坑验证）：
     1. 组合各段必须 subfilter<段> 包裹后再并集——段内 -/+ 前缀会越界作用于整个累计结果；
     2. 勿在 run 内用 then<var>else<var> 做变体选择（then/else 是逐标题输出映射）。 -->

<$list
    filter="[<currentTiddler>tag[$:/tags/TidmeDeck]]"
    variable="deckTiddler"
>
    <$reveal
        type="nomatch"
        stateTitle=<<folded-state>>
        text="hide"
        default="show"
        animate="yes"
    >
        <div style="text-align: center;">
            <div>
                <h2>
                    <$wikify
                        name="deckCaption"
                        text={{{ [<deckTiddler>get[caption]] ~[<deckTiddler>split[/]last[]] }}}
                        mode="inline"
                        output="text"
                    >
                        <<deckCaption>>
                    </$wikify>
                </h2>
            </div>
            <div>
                <$text
                    text={{{ [<deckTiddler>get[card]] }}}
                />
            </div>
            <div>
                <$let
                    filter_search=`[[$(deckTiddler)$]] [[$(deckTiddler)$]shadowsource[]] [subfilter{$(deckTiddler)$!!card}is[tiddler]] [[$(deckTiddler)$]shadowsource[]plugintiddlers[]is[tiddler]] +[!prefix[$:/plugins/keepone/tidme/]]`
                >
                    <$list
                        filter="[all[shadows+tiddlers]tag[$:/tags/TidmeDeck/Action]!is[draft]]"
                        template="$:/plugins/keepone/tidme/review/ui/ViewTemplate/button"
                    />
                </$let>
            </div>
        </div>

        <br>{{!!description}}<br>
        <$let
            filter_learn=`${ [<deckTiddler>deckfilter[learn]] }$`
            filter_due=`${ [<deckTiddler>deckfilter[due]] }$`
            filter_new=`${ [<deckTiddler>deckfilter[newly]] }$`
            filter_unfold=`${ [<deckTiddler>deckfilter[unfold]] }$`
            due-new=`${ [<deckTiddler>deckfilter[duenew]] }$`
            new-due=`${ [<deckTiddler>deckfilter[newdue]] }$`
            random=`${ [<deckTiddler>deckfilter[randomcombo]] }$`
            filter_queue=`${ [<deckTiddler>deckfilter[queue]] }$`
        >
            <div class="tm-deck-details">
                <$tidme-deck-badges deck=<<deckTiddler>> class="tm-deck-counts"/>
                <div class="tm-deck-study-actions">
                    <$list
                        filter="[all[shadows+tiddlers]tag[$:/tags/TidmeDeck/Study]!is[draft]]"
                        template="$:/plugins/keepone/tidme/review/ui/ViewTemplate/button"
                    />
                </div>
            </div>
        </$let>
    </$reveal>
</$list>
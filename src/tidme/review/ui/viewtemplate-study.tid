title: $:/plugins/keepone/tidme/review/ui/ViewTemplate/study
tags: $:/tags/ViewTemplate
list-after:
code-body: yes

\whitespace trim

\define foldaction()
<$action-setfield
    $tiddler={{{ [<studyTiddler>addprefix[$:/state/folded/]] }}}
    text={{{ [<studyTiddler>addprefix[$:/state/folded/]get[text]match[hide]then[show]else[hide]] }}}
/>
\end

<$list
    filter="[<studyTiddler>!is[blank]!tidme.kind[topic]]"
    variable="studyTiddler"
>
    <div class="tmc-study-bar">
        <div class="tmc-study-count">
            <span class={{{ [subfilter<filter_learn>match<studyTiddler>then[tm-badge tm-badge-learn tm-badge-active]else[tm-badge tm-badge-learn]] }}}><$count filter="[subfilter<filter_learn>]"/></span>
            <span class={{{ [subfilter<filter_due>match<studyTiddler>then[tm-badge tm-badge-due tm-badge-active]else[tm-badge tm-badge-due]] }}}><$count filter="[subfilter<filter_due>]"/></span>
            <span class={{{ [subfilter<filter_new>match<studyTiddler>then[tm-badge tm-badge-new tm-badge-active]else[tm-badge tm-badge-new]] }}}><$count filter="[subfilter<filter_new>]"/></span>
        </div>
        <$fieldmangler>
            <$fsrs4tw.repeat ratings="Again Hard Good Easy">
        </$fieldmangler>
    </div>
    <details class="tmc-card-stats" style="margin-top:8px;">
        <summary style="cursor:pointer;color:var(--tm-text-2,#777);font-size:12px;">📊 Study Data</summary>
        <div class="tmc-card-stats-grid" style="margin-top:6px;padding:8px 12px;background:var(--tm-surface-2);color:var(--tm-text-1);border-radius:6px;font-size:12px;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:6px 12px;border:1px solid var(--tm-border);">
            <$let
                st={{{ [<studyTiddler>get[state]else[0]] }}}
                due={{{ [<studyTiddler>get[due]] }}}
                last={{{ [<studyTiddler>get[last_review]] }}}
            >
                <div><strong>FSRS State: </strong><$text text={{{ [<st>match[0]then[New]]~[<st>match[1]then[Learning]]~[<st>match[2]then[Review]]~[<st>match[3]then[Relearning]]~[[未知]] }}}/></div>
                <div><strong>Due: </strong><$text text={{{ [<st>match[0]then[Scheduled after first review]]~[<due>format:relativedate[]] }}}/></div>
                <div><strong>Last Review: </strong><$text text={{{ [<st>match[0]then[Not reviewed]]~[<last>format:relativedate[]] }}}/></div>
                <div><strong>Interval: </strong><$text text={{{ [<studyTiddler>get[scheduled_days]else[0]] }}}/> d</div>
                <div><strong>Stability (S): </strong><$text text={{{ [<studyTiddler>get[stability]else[—]] }}}/></div>
                <div><strong>Difficulty (D): </strong><$text text={{{ [<studyTiddler>get[difficulty]else[—]] }}}/></div>
                <div><strong>Reps: </strong><$text text={{{ [<studyTiddler>get[reps]else[0]] }}}/></div>
                <div><strong>Lapses: </strong><$text text={{{ [<studyTiddler>get[lapses]else[0]] }}}/></div>
                <div><strong>Priority: </strong>p<$text text={{{ [<studyTiddler>get[tidme.priority]else[50]] }}}/></div>
                <div><strong>A-Factor：</strong><$text text={{{ [<studyTiddler>get[tidme.afactor]else[1.5]] }}}/></div>
            </$let>
        </div>
    </details>
</$list>

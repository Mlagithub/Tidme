title: $:/plugins/keepone/tidme/review/ui/viewtemplate/today-deck-row

<$let deckTiddler=<<currentTiddler>>>
<div class="tm-today-deck-row">
<$link to=<<deckTiddler>>><span class="tm-today-deck-name"><$wikify name="deckCaption" text={{{ [<deckTiddler>get[caption]] ~[<deckTiddler>split[/]last[]] }}} mode="inline" output="text"><<deckCaption>></$wikify></span></$link>
<$tidme-deck-badges deck=<<deckTiddler>> class="tm-today-deck-counts"/>
<span class="tm-today-deck-open">
<!-- 行内「选项」：与牌组详情视图共用同一套按钮模板——temp 初始化、弹窗参数、
     默认牌组排除（其参数入口在设置页）都由 options 动作 tiddler 单一来源提供 -->
{{$:/plugins/keepone/tidme/review/buttons/action/options||$:/plugins/keepone/tidme/review/ui/ViewTemplate/button}}
<$link to=<<deckTiddler>> class="tm-btn tm-btn--sm">Open ›</$link></span>
</div>
</$let>

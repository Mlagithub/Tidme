                    <div class="tm-setting-desc">{{$:/language/tidme/settings.memory.retention.desc}}</div>
                </div>
                <div class="tm-setting-control"><<fsrsretention>></div>
            </div>
            <div class="tm-setting-row">
                <div class="tm-setting-info">
                    <div class="tm-setting-title">{{$:/language/tidme/settings.memory.maxinterval}}</div>
                    <div class="tm-setting-desc">{{$:/language/tidme/settings.memory.maxinterval.desc}}</div>
                </div>
                <div class="tm-setting-control"><<fsrsmaxinterval>></div>

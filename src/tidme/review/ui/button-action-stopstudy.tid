title: $:/plugins/keepone/tidme/review/buttons/action/stopstudy
tags: $:/tags/TidmeDeck/Study
icon: $:/plugins/keepone/tidme/review/icons/stop
caption: {{$:/language/tidme/stopstudy}}
description: {{$:/language/tidme/stopstudy}}
condition: [<deckTiddler>addsuffix[/study]has[title]]
button-classes: tmc-button-show
code-body: yes

<$action-deletetiddler
    $tiddler={{{ [<deckTiddler>addsuffix[/study]] }}}
/>
<$action-deletetiddler
    $filter="[all[shadows+tiddlers]prefix[$:/temp/tidme/]]"
/>
<!-- 子集牌组手动停止即焚：显式停止 = 临时脚手架使命结束（普通牌组不受影响） -->
<$list
    filter="[<deckTiddler>has[tidme.subset-doc]]"
    variable="ignore"
>
    <$action-deletetiddler
        $tiddler={{{ [<deckTiddler>addsuffix[/log]] }}}
    />
    <$action-deletetiddler
        $tiddler=<<deckTiddler>>
    />
</$list>
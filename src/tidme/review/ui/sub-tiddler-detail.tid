code-body: yes
title: $:/plugins/keepone/tidme/review/ui/ViewTemplate/tiddler
<!-- !!同步守护：本 $let 的过滤器组合与 core/deck-engine.composeDeckFilters 保持同构（JS 侧唯一真源）；修改任一侧须同步 review/ui/ViewTemplate/{deck,tiddler}.tid 两处模板。
     过滤器组合两条铁律（均在真实 TW 踩坑验证）：
     1. 勿在 run 内用 then<var>else<var> 做"变体选择"——then/else 是逐标题输出映射，
        每张未命中卡都会把 var 文本当结果项输出（伪标题混入学习队列，被 startstudy 首选）。
        变体选择用 $let 文本层 ${ [...then<..>else<..>] }$ 内插（输入只有 deckTiddler 一项，恰输出一次）。
     2. 组合队列各段必须 subfilter<段> 包裹后再并集——段内 -/+ 前缀会越界作用于
        整个累计结果（裸拼接导致 learn/due 段被后续段的 +[state_*] 交运算洗掉）。 -->

\whitespace trim

<$let
    studyTiddler=<<currentTiddler>>
    deckTiddler={{{ [subfilter{$:/config/Tidme/Filters/decktiddler}first[]] }}}
    p={{{ [<deckTiddler>get[p]else{$:/Deck/default!!p}] }}}
    exclude_action={{{ [<deckTiddler>get[exclude_action]else{$:/Deck/default!!exclude_action}] }}}
    unfold_action={{{ [<deckTiddler>get[unfold_action]else{$:/Deck/default!!unfold_action}] }}}
    leech_threshold={{{ [<deckTiddler>get[leech_threshold]else{$:/Deck/default!!leech_threshold}] }}}
    leech_action={{{ [<deckTiddler>get[leech_action]else{$:/Deck/default!!leech_action}] }}}
    filter_learn=`${ [<deckTiddler>deckfilter[learn]] }$`
    filter_due=`${ [<deckTiddler>deckfilter[due]] }$`
    filter_new=`${ [<deckTiddler>deckfilter[newly]] }$`
    filter_unfold=`${ [<deckTiddler>deckfilter[unfold]] }$`
    due-new=`${ [<deckTiddler>deckfilter[duenew]] }$`
    new-due=`${ [<deckTiddler>deckfilter[newdue]] }$`
    random=`${ [<deckTiddler>deckfilter[randomcombo]] }$`
    filter_queue=`${ [<deckTiddler>deckfilter[queue]] }$`
>
    <$transclude
        tiddler={{{ [<currentTiddler>] :cascade[all[shadows+tiddlers]tag[$:/tags/StoryTiddlerTemplateFilter]![$:/config/Tidme/StoryTiddlerTemplateFilters/card]!is[draft]get[text]] :and[has[title]else[$:/core/ui/ViewTemplate]] }}}
    />
</$let>

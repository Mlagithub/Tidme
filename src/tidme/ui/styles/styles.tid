    justify-content:center;
}

.tmc-tr-action{
    flex:0 1 15%;
    display: flex;
    justify-content:flex-end;
}



.tmc-btn-primary {
    background: var(--tm-accent);
    color: var(--tm-surface);
    fill: var(--tm-surface);
}


/* 复习评分条：sticky 顶部固定，长卡片评分随手可点 */
.tmc-study-bar {
    position: sticky;
    top: 0;
    z-index: 60;
    /* 不透明底色（写死，理由同 .tm-section-bar） */
    background-color: #ffffff;
    padding: 4px 0 6px;
    border-bottom: 1px solid var(--tm-border);
}
.tmc-study-count { font-size: 10px; color: var(--tm-text-2); }

.tmc-repeat-wrapper {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 10px;
	margin: 16px 0 10px;
	width: 100%;
}
.tmc-repeat-wrapper button {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 10px 8px;
	border-radius: var(--tm-radius-sm) !important;
	border: 1px solid var(--tm-border) !important;
	background: var(--tm-surface) !important;
	box-shadow: var(--tm-shadow-sm);
	cursor: pointer;
	text-decoration: none !important;
	transition: var(--tm-transition) !important;
	width: 100%;
}
.tmc-repeat-wrapper button:hover {
	transform: translateY(-2px);
	box-shadow: var(--tm-shadow-md);
	border-color: currentColor !important;
	background: var(--tm-surface-2) !important;
}

.tmc-repeat-wrapper-1 {
	display: flex;
	justify-content: center;
	margin-top: 16px;
}

.tmc-decks-button-wrapper{
    display:flex;
    justify-content: space-around;
    align-items: baseline;
}

.tmc-file-input-wrapper {
    position: relative;
    overflow: hidden;
    vertical-align: middle;
}

.tmc-file-input-wrapper input[type=file] {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    font-size: 999px;
    max-width: 100%;
    max-height: 100%;
    filter: alpha(opacity=0);
    opacity: 0;
    outline: none;
    background: white;
    cursor: pointer;
    display: inline-block;
}

.tmc-title-hide ~ .tc-tiddler-title .tc-title{

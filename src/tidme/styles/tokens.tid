title: $:/plugins/keepone/tidme/styles/tokens
tags: $:/tags/Stylesheet
type: text/css

/* ============================================================
   Tidme 设计系统（统一 token + 组件基类）
   风格：现代学习/知识应用（卡面 + 柔和阴影 + 圆角 + 主色按钮 + 留白分隔）
   所有插件页面的 tm-* 组件统一引用此处的 token 与基类。
   ============================================================ */

:root {
	/* ---- 默认继承 TW5 调色板，确保完美兼容任何原生亮/暗主题 ---- */
	--tm-surface: <<colour tiddler-background>>;
	--tm-surface-2: <<colour background>>;
	--tm-surface-3: <<colour very-light-background>>;
	--tm-border: <<colour table-border>>;
	--tm-text-1: <<colour foreground>>;
	--tm-text-2: <<colour muted-foreground>>;
	--tm-text-3: hsl(220, 10%, 42%);

	--tm-accent: hsl(245, 75%, 60%);
	--tm-accent-strong: hsl(245, 75%, 50%);
	--tm-accent-soft: rgba(99, 102, 241, 0.15);

	--tm-success: hsl(150, 75%, 32%);
	--tm-success-soft: hsl(150, 75%, 95%);
	--tm-warn: hsl(35, 85%, 40%);
	--tm-warn-soft: hsl(35, 85%, 95%);
	--tm-danger: hsl(0, 80%, 50%);
	--tm-danger-soft: hsl(0, 80%, 96%);
	--tm-info: hsl(210, 85%, 45%);
	--tm-info-soft: hsl(210, 85%, 95%);

	/* 渐变色 */
	--tm-gradient-primary: linear-gradient(135deg, hsl(245, 75%, 64%) 0%, hsl(245, 75%, 54%) 100%);
	--tm-gradient-success: linear-gradient(135deg, hsl(150, 75%, 38%) 0%, hsl(150, 75%, 28%) 100%);
	--tm-gradient-warn: linear-gradient(135deg, hsl(35, 85%, 48%) 0%, hsl(35, 85%, 38%) 100%);

	/* 徽章 pastel 语义 */
	--tm-badge-new-bg: hsl(210, 90%, 94%);   --tm-badge-new-fg: hsl(210, 90%, 35%);
	--tm-badge-learn-bg: hsl(35, 90%, 94%);  --tm-badge-learn-fg: hsl(35, 90%, 35%);
	--tm-badge-due-bg: hsl(150, 80%, 93%);   --tm-badge-due-fg: hsl(150, 80%, 28%);
	--tm-badge-overdue-bg: hsl(0, 85%, 94%); --tm-badge-overdue-fg: hsl(0, 85%, 38%);
	--tm-badge-suspended-bg: hsl(270, 80%, 95%); --tm-badge-suspended-fg: hsl(270, 80%, 35%);

	/* 圆角 */
	--tm-radius: 12px;
	--tm-radius-sm: 8px;
	--tm-radius-xs: 5px;

	/* 阴影 */
	--tm-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
	--tm-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.06), 0 2px 6px -1px rgba(0, 0, 0, 0.04);
	--tm-shadow-lg: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 16px -6px rgba(0, 0, 0, 0.06);

	/* 字体 */
	--tm-font: -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans GB",
		"Microsoft YaHei", "Noto Sans SC", system-ui, sans-serif;
	--tm-font-mono: "SF Mono", "Cascadia Code", Consolas, "JetBrains Mono", monospace;

	/* 动效缓动 */
	--tm-transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);

	/* 间距 */
	--tm-gap: 5px;
	--tm-gap-lg: 10px;
	--tm-gap-xl: 16px;
	--tm-gap-2xl: 24px;

	/* 兼容旧引用 */
	--tm-gap-lg-old: 10px;
	--tm-badge-new: var(--tm-badge-new-bg);
	--tm-badge-learn: var(--tm-badge-learn-bg);
	--tm-badge-due: var(--tm-badge-due-bg);
	--tm-badge-overdue: var(--tm-badge-overdue-bg);
	--tm-badge-suspended: var(--tm-badge-suspended-bg);
}

/* ---- 按钮（统一：ghost/描边/主色/危险/文字） ---- */
.tm-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.4em;
	font-family: var(--tm-font);
	font-size: 0.85em;
	font-weight: 550;
	padding: 7px 15px;
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius-sm);
	background: var(--tm-surface);
	color: var(--tm-text-2);
	cursor: pointer;
	line-height: 1.4;
	transition: var(--tm-transition);
}
.tm-btn:hover {
	background: var(--tm-surface-2);
	color: var(--tm-text-1);
	border-color: var(--tm-border);
	transform: translateY(-1px);
	box-shadow: var(--tm-shadow-sm);
}
.tm-btn:active { transform: translateY(0.5px); }
.tm-btn:disabled { opacity: 0.45; cursor: default; transform: none; box-shadow: none; }
.tm-btn.focus, .tm-btn:focus-visible { outline: 2px solid var(--tm-accent-soft); outline-offset: 1px; }

.tm-btn--primary {
	background: var(--tm-gradient-primary);
	border-color: transparent;
	color: #fff;
	font-weight: 600;
	box-shadow: var(--tm-shadow-sm);
}
.tm-btn--primary:hover {
	background: var(--tm-gradient-primary);
	filter: brightness(1.08);
	border-color: transparent;
	color: #fff;
	box-shadow: var(--tm-shadow);
	transform: translateY(-1.5px);
}
.tm-btn--danger {
	background: var(--tm-danger-soft);
	border-color: transparent;
	color: var(--tm-danger);
}
.tm-btn--danger:hover {
	background: hsl(0, 80%, 90%);
	color: var(--tm-danger);
	transform: translateY(-1px);
}
.tm-btn--ghost { border-color: transparent; background: transparent; color: var(--tm-text-2); }
.tm-btn--ghost:hover { background: var(--tm-surface-2); color: var(--tm-text-1); transform: none; box-shadow: none; }
.tm-btn--active {
	background: var(--tm-accent-soft);
	border-color: transparent;
	color: var(--tm-accent-strong);
}

/* ---- 卡片（卡面） ---- */
.tm-card {
	background: var(--tm-surface);
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	box-shadow: var(--tm-shadow);
	transition: var(--tm-transition);
}
.tm-card:hover {
	box-shadow: var(--tm-shadow-lg);
}
.tm-card--flat { box-shadow: none; }
.tm-card--flat:hover { box-shadow: none; }

/* ---- 页面级标题/说明（替代系统路径标题的气场） ---- */
.tm-page-head { margin: 4px 0 8px; }
.tm-page-title {
	font-family: var(--tm-font);
	font-size: 1.4em;
	font-weight: 700;
	letter-spacing: -0.01em;
	color: var(--tm-text-1);
}
.tm-page-desc { margin-top: 4px; font-size: 0.9em; color: var(--tm-text-2); line-height: 1.5; }

/* ---- 表格（hairline 分隔 + 行 hover） ---- */
.tm-table-wrap {
	background: var(--tm-surface);
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	box-shadow: var(--tm-shadow-sm);
	overflow: hidden;
}
.tm-table { width: 100%; border-collapse: collapse; }
.tm-table th {
	text-align: left;
	font-size: 0.78em;
	font-weight: 600;
	letter-spacing: 0.02em;
	text-transform: uppercase;
	color: var(--tm-text-2);
	padding: 10px 14px;
	border-bottom: 1px solid var(--tm-border);
	background: var(--tm-surface-2);
}
.tm-table td { padding: 10px 14px; border-bottom: 1px solid var(--tm-border); color: var(--tm-text-1); font-size: 0.88em; }
.tm-table tr:last-child td { border-bottom: none; }
.tm-table tbody tr:hover { background: var(--tm-surface-2); }

/* ---- 徽章（pill）高优先级选择器，防 TW5 .tc-tiddlylink 色值覆盖 ---- */
.tm-badge, button.tm-badge, a.tm-badge {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.25em;
	padding: 1px 8px;
	border-radius: 999px;
	font-size: 0.74em;
	font-weight: 600;
	line-height: 1.6;
	white-space: nowrap;
}
.tm-badge-new, button.tm-badge-new, a.tm-badge-new { background: var(--tm-badge-new-bg) !important; color: var(--tm-badge-new-fg) !important; }
.tm-badge-learn, button.tm-badge-learn, a.tm-badge-learn { background: var(--tm-badge-learn-bg) !important; color: var(--tm-badge-learn-fg) !important; }
.tm-badge-due, button.tm-badge-due, a.tm-badge-due { background: var(--tm-badge-due-bg) !important; color: var(--tm-badge-due-fg) !important; }
.tm-badge-overdue, button.tm-badge-overdue, a.tm-badge-overdue { background: var(--tm-badge-overdue-bg) !important; color: var(--tm-badge-overdue-fg) !important; }
.tm-badge-suspended, button.tm-badge-suspended, a.tm-badge-suspended { background: var(--tm-badge-suspended-bg) !important; color: var(--tm-badge-suspended-fg) !important; }

/* ---- 标签页（pill） ---- */
.tm-tab {
	display: inline-flex;
	align-items: center;
	gap: 0.35em;
	padding: 5px 12px;
	font-size: 0.85em;
	font-weight: 500;
	border: 1px solid var(--tm-border);
	border-radius: 999px;
	background: var(--tm-surface);
	color: var(--tm-text-2);
	cursor: pointer;
	transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.tm-tab:hover { color: var(--tm-text-1); border-color: var(--tm-border); }
.tm-tab--active {
	background: var(--tm-accent);
	border-color: var(--tm-accent);
	color: #fff;
	font-weight: 600;
}

/* ---- 内滚动容器 ---- */
.tm-scroll { max-height: 340px; overflow-y: auto; }
.tm-scroll-lg { max-height: 480px; overflow-y: auto; }
.tm-scroll-sm { max-height: 220px; overflow-y: auto; }

/* ---- 进度条（圆角） ---- */
.tm-progress {
	height: 6px;
	border-radius: 999px;
	background: var(--tm-surface-3);
	overflow: hidden;
}
.tm-progress-fill { height: 100%; border-radius: 999px; background: var(--tm-accent); transition: width 0.2s ease; }

/* ---- 仪表盘卡片块 (Dashboard Card Blocks) ---- */
.tm-dashboard-card {
	background: var(--tm-surface);
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	padding: 18px 22px;
	box-shadow: var(--tm-shadow-sm);
	margin-bottom: 18px;
	transition: var(--tm-transition);
}
.tm-dashboard-card-title {
	font-size: 0.82em;
	font-weight: 700;
	letter-spacing: 0.04em;
	text-transform: uppercase;
	color: var(--tm-text-1);
	margin-bottom: 12px;
	border-bottom: 1px dashed var(--tm-border);
	padding-bottom: 8px;
}

/* ============================================================
   深色专有主题（当点击 Tidme 深色切换或 TW 启用暗色调色板时）
   ============================================================ */

[data-tme-dark],
html.tc-dark-palette,
body.tc-body-dark,
[data-theme="dark"] {
	--tm-surface: #1e293b;
	--tm-surface-2: #16233a;
	--tm-surface-3: #0f172a;
	--tm-border: #334155;
	--tm-text-1: #f8fafc;
	--tm-text-2: #cbd5e1;
	--tm-text-3: #94a3b8;
	--tm-accent: #818cf8;
	--tm-accent-strong: #a5b4fc;
	--tm-accent-soft: rgba(129, 140, 248, 0.2);
	--tm-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.5);
	--tm-shadow: 0 1px 2px rgba(0, 0, 0, 0.5), 0 6px 16px rgba(0, 0, 0, 0.4);
	--tm-shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.6);
	--tm-badge-new-bg: #1e3a5f;   --tm-badge-new-fg: #93c5fd;
	--tm-badge-learn-bg: #5b3d0e; --tm-badge-learn-fg: #fcd34d;
	--tm-badge-due-bg: #0f3d2e;   --tm-badge-due-fg: #6ee7b7;
	--tm-badge-overdue-bg: #5c1a1a; --tm-badge-overdue-fg: #fca5a5;
	--tm-badge-suspended-bg: #3b2f63; --tm-badge-suspended-fg: #c4b5fd;
}

[data-tme-dark] body,
body.tc-body-dark {
	background: #0f172a;
	color: var(--tm-text-1);
}

/* 深色下顶部条栏不透明兜底（与 styles.tid 的 solid fallback 配合，防止半透明底色透出正文） */
[data-tme-dark] .tm-section-bar,
[data-tme-dark] .tmc-study-bar {
	background: #1e293b;
}
[data-tme-dark] .tc-page-container,
[data-tme-dark] .tc-story-river,
[data-tme-dark] .tc-sidebar-scrollable,
[data-tme-dark] .tc-tiddler-frame,
[data-tme-dark] .tm-import-panel,
[data-tme-dark] .tm-stat-cards,
[data-tme-dark] .tm-section-bar {
	background: var(--tm-surface);
	color: var(--tm-text-1);
}
[data-tme-dark] .tc-tiddler-frame {
	border-color: var(--tm-border);
}
[data-tme-dark] a.tc-tiddlylink { color: var(--tm-accent); }
[data-tme-dark] .tc-page-container { background: var(--tm-surface-3); }

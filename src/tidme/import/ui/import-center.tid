title: $:/plugins/keepone/tidme/import/ui/import-center
caption: {{$:/language/tidme/import.title}}
type: text/vnd.tiddlywiki

<$tidme-nav/>

<div class="tm-import-tabs">
<$radio tiddler="$:/state/tidme/import/tab" value="file" class="tm-tab tm-import-tab" selectedClass="tm-tab tm-import-tab tm-tab--active"><$transclude tiddler="$:/language/tidme/import.tab.localfiles">Local Files</$transclude></$radio>
<$radio tiddler="$:/state/tidme/import/tab" value="paste" class="tm-tab tm-import-tab" selectedClass="tm-tab tm-import-tab tm-tab--active"><$transclude tiddler="$:/language/tidme/import.tab.pastetext">Paste Text</$transclude></$radio>
<$radio tiddler="$:/state/tidme/import/tab" value="clips" class="tm-tab tm-import-tab" selectedClass="tm-tab tm-import-tab tm-tab--active"><$transclude tiddler="$:/language/tidme/import.tab.inboxclips">Web Clips</$transclude></$radio>
</div>

<$reveal type="match" state="$:/state/tidme/import/tab" text="file" default="file">
<$import-file/>
</$reveal>

<$reveal type="match" state="$:/state/tidme/import/tab" text="paste">
<$paste-split/>
</$reveal>

<$reveal type="match" state="$:/state/tidme/import/tab" text="clips">
<$clips-split/>
</$reveal>

---

<$link to="$:/plugins/keepone/tidme/import/ui/help-shortcuts"><$transclude tiddler="$:/language/tidme/import.shortcuts.manual">Shortcuts & Manual</$transclude></$link>

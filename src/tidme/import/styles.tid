title: $:/plugins/keepone/tidme/import/styles
tags: $:/tags/Stylesheet
type: text/css

/* 设计 token / tm-btn 基类统一由 $:/plugins/keepone/tidme/core/styles/tokens 提供 */

/* ===== 按钮：tm-btn 基类与变体统一由 core/styles/tokens 提供；此处仅图标尺寸 ===== */
.tm-btn-icon { padding: 2px 6px; }
.tm-btn-icon img, .tm-btn-icon svg { width: 1em; height: 1em; vertical-align: -0.15em; }

/* ===== 空状态 ===== */
.tm-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--tm-gap);
	padding: 18px 8px;
	color: <<colour muted-foreground>>;
	font-size: 0.9em;
	text-align: center;
}
.tm-empty-icon { font-size: 1.8em; opacity: 0.45; line-height: 1; }

/* ===== Toast 反馈 ===== */
.tm-toast {
	padding: 6px 12px;
	border-radius: var(--tm-radius);
	border: 1px solid <<colour muted-foreground>>;
	background: <<colour background>>;
	font-size: 0.9em;
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
}
.tm-toast--ok { border-color: #22c55e; color: #15803d; }
.tm-toast--err { border-color: <<colour danger>>; color: <<colour danger>>; }

/* 统计面板（P1：指标卡 / 表格 / 进度条 / 漏斗横条） */
.tm-stat-cards {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(7em, 1fr));
	gap: var(--tm-gap-lg);
	margin: 8px 0;
}
.tm-stat-card {
	border: 1px solid <<colour muted-foreground>>;
	border-radius: var(--tm-radius);
	padding: 8px 10px;
	text-align: center;
	background: <<colour very-light-background>>;
}
.tm-stat-num {
	font-size: 1.6em;
	font-weight: 600;
	line-height: 1.2;
}
.tm-stat-label {
	font-size: 0.85em;
	opacity: 0.7;
}
.tm-stat-sub {
	font-size: 0.8em;
	opacity: 0.6;
}
/* 统计面板：区块标题 + 指标卡 + 表格 + 进度条（复用 core token） */
.tm-section-title {
	font-size: 0.78em;
	font-weight: 600;
	letter-spacing: 0.02em;
	text-transform: uppercase;
	color: var(--tm-text-3);
	margin: 20px 0 8px;
}
.tm-stat-cards {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(7em, 1fr));
	gap: var(--tm-gap-lg);
}
.tm-stat-card {
	background: var(--tm-surface);
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	box-shadow: var(--tm-shadow-sm);
	padding: 12px 8px;
	text-align: center;
}
.tm-stat-num { font-size: 1.6em; font-weight: 700; color: var(--tm-text-1); font-variant-numeric: tabular-nums; line-height: 1.2; }
.tm-stat-label { font-size: 0.8em; color: var(--tm-text-2); margin-top: 2px; }
.tm-stat-sub { font-size: 0.74em; color: var(--tm-text-3); margin-top: 2px; }
.tm-stat-inline { font-size: 0.9em; color: var(--tm-text-2); padding: 2px 0; }
.tm-stats-table { border-collapse: collapse; width: 100%; font-size: 0.92em; }
.tm-stats-table th, .tm-stats-table td { border-bottom: 1px solid var(--tm-border); padding: 8px 12px; text-align: left; }
.tm-stats-table th { color: var(--tm-text-3); font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.02em; font-weight: 600; }
.tm-stat-doc { justify-content: flex-start; }
.tm-stat-doc-name { font-size: 0.9em; color: var(--tm-text-1); }
.tm-doc-prog-row { display: flex; align-items: center; gap: 10px; padding: 4px 0; }
.tm-stat-bar {
	display: inline-block;
	width: 10em;
	height: 6px;
	border-radius: 999px;
	background: var(--tm-surface-3);
	vertical-align: middle;
	overflow: hidden;
	box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.05);
}
.tm-stat-bar-fill {
	display: block;
	height: 100%;
	border-radius: 999px;
	background: var(--tm-gradient-primary);
	box-shadow: 0 1px 2px rgba(99, 102, 241, 0.2);
	transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.tm-stat-bar-lg { width: 12em; }
.tm-stat-funnel-row { display: flex; align-items: center; gap: var(--tm-gap-lg); margin: 5px 0; font-size: 0.92em; }
.tm-stat-funnel-label { min-width: 3em; color: var(--tm-text-2); }
.tm-stat-funnel-num { min-width: 2em; text-align: right; color: var(--tm-text-1); font-variant-numeric: tabular-nums; }
.tm-stat-pills {
	display: flex;
	gap: 8px;
	flex-wrap: wrap;
	margin: 6px 0;
}
.tm-stat-pills .tm-badge {
	font-size: 0.82em;
	padding: 3px 10px;
	font-weight: 600;
}

/* 导入中心文件卡片（P1） */
.tm-import-file-card {
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	padding: 6px 10px;
	margin: 6px 0;
	background: var(--tm-surface);
}
.tm-import-file-card-err {
	border-color: var(--tm-danger);
	opacity: 0.8;
}
.tm-import-file-head {
	display: flex;
	align-items: center;
	gap: var(--tm-gap-lg);
	flex-wrap: wrap;
}
.tm-import-file-title {
	font-weight: 600;
}
.tm-import-file-badge {
	font-size: 0.75em;
	padding: 0 6px;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 3px;
	opacity: 0.75;
	text-transform: uppercase;
}
.tm-import-file-meta {
	font-size: 0.85em;
	opacity: 0.65;
}
/* 树形目录大纲 */
.tm-import-tree {
	margin: 4px 0 2px;
	max-height: 14em;
	overflow: auto;
}
.tm-import-tree-row {
	display: flex;
	align-items: center;
	gap: 0.4em;
	border-left: 2px solid <<colour muted-foreground>>;
	opacity: 0.85;
	padding-left: 0.5em;
	margin-left: 0.2em;
	font-size: 0.9em;
}
.tm-import-tree-row:hover {
	opacity: 1;
}
.tm-import-tree-merged {
	border-left-color: #94a3b8;
	background: var(--tm-mark-merged);
}
.tm-import-tree-text {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.tm-import-tree-mark {
	font-size: 0.8em;
	opacity: 0.6;
}

/* 文档页进度横幅（P1 卡片化） */
/* ===== 页面间导航条（分隔线 + 当前页高亮） ===== */
.tm-nav {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	font-size: 0.9em;
	margin: 0 0 16px;
}
.tm-nav-item {
	display: inline-flex;
	align-items: center;
	padding: 5px 16px;
	color: var(--tm-text-2);
	text-decoration: none;
	border-right: 1px solid var(--tm-border);
	transition: color 0.12s ease, background 0.12s ease;
}
.tm-nav-item:first-child { padding-left: 0; }
.tm-nav-item:last-child { border-right: none; }
.tm-nav-item:hover { color: var(--tm-text-1); background: var(--tm-surface-2); }
.tm-nav-item.tm-nav-active { color: var(--tm-accent); font-weight: 600; }

/* 文档页正文的节链接列表：限高内滚动（章节多的文档不撑长页面） */
.tc-tiddler-frame:has(.tm-doc-resume) .tc-tiddler-body ul {
	max-height: 300px;
	overflow-y: auto;
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius-sm);
	padding: 6px 10px;
	background: var(--tm-surface);
}
.tc-tiddler-frame:has(.tm-doc-resume) .tc-tiddler-body ul li { padding: 2px 0; }

/* 文档页：进度横幅卡片化 */
.tm-doc-banner {
	display: flex;
	align-items: center;
	gap: var(--tm-gap-xl);
	flex-wrap: wrap;
	padding: 16px 20px;
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	background: var(--tm-surface);
	box-shadow: var(--tm-shadow-sm);
	margin: 8px 0;
}
.tm-doc-prog {
	display: flex;
	flex-direction: column;
	gap: 3px;
	min-width: 11em;
}
.tm-doc-prog-num {
	font-size: 1.6em;
	font-weight: 700;
	line-height: 1.1;
	color: var(--tm-text-1);
}
.tm-doc-prog-done {
	color: var(--tm-accent);
}
.tm-doc-prog-total {
	color: var(--tm-text-3);
	font-weight: 400;
}
.tm-doc-prog-label {
	font-size: 0.85em;
	color: var(--tm-text-2);
}
.tm-doc-banner-actions {
	display: flex;
	gap: var(--tm-gap-lg);
	margin-left: auto;
	flex-wrap: wrap;
}

/* 导入中心 Tab（pill，沿用 core tm-tab） */
.tm-import-tabs {
	display: flex;
	gap: var(--tm-gap-lg);
	flex-wrap: wrap;
	margin: 12px 0 16px;
}
.tm-import-tab { font-size: 0.9em; }
.tm-import-tab:hover { border-color: rgba(17, 24, 39, 0.18); }
.tm-import-body { padding: 16px 18px; }

.tm-import-panel {
	margin-top: 0.5em;
}
.tm-import-dropzone {
	border: 2px dashed var(--tm-text-3);
	border-radius: var(--tm-radius);
	padding: 2.2em 1.5em;
	text-align: center;
	cursor: pointer;
	margin: 10px 0;
	color: var(--tm-text-2);
	background: var(--tm-surface-2);
	font-weight: 550;
	transition: var(--tm-transition);
}
.tm-import-dropzone:hover {
	border-color: var(--tm-accent);
	color: var(--tm-text-1);
	background: var(--tm-surface-3);
}
.tm-import-dropzone.tm-import-over {
	border-color: var(--tm-accent);
	color: var(--tm-accent-strong);
	background: var(--tm-accent-soft);
	box-shadow: 0 0 10px rgba(99, 102, 241, 0.1);
}
.tm-import-row {
	padding: 0.25em 0;
}
.tm-import-error {
	color: <<colour danger>>;
}
.tm-import-muted {
	opacity: 0.7;
	font-size: 0.9em;
}
.tm-import-actions {
	display: flex;
	gap: 0.5em;
	margin-top: 0.5em;
}
/* G10 服务端后台处理选项 */
.tm-import-server-row {
	display: flex;
	align-items: center;
	gap: 0.4em;
	margin: 6px 0 2px;
	font-size: 0.92em;
}
.tm-section-bar {
	position: sticky;
	top: 0;
	z-index: 60;
	background: <<colour background>>;
	box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
	display: flex;
	flex-direction: column;
	gap: 2px;
	padding: 2px 0;
	margin-bottom: 4px;
	border-bottom: 1px dotted <<colour muted-foreground>>;
	font-size: 0.92em;
}
.tm-section-row {
	display: flex;
	align-items: center;
	gap: 0.5em;
	flex-wrap: wrap;
}
.tm-section-crumb {
	cursor: pointer;
}
.tm-section-pos {
	opacity: 0.75;
}
.tm-section-load {
	opacity: 0.75;
}
.tm-section-state {
	color: <<colour primary>>;
	opacity: 0.9;
}
/* 统一按钮风格：全部 tm-sec-btn 基类 + 语义修饰（沿用 core design token） */
.tm-sec-btn {
	display: inline-flex;
	align-items: center;
	gap: 0.35em;
	font-family: var(--tm-font);
	font-size: 0.88em;
	font-weight: 500;
	padding: 4px 10px;
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius-sm);
	background: var(--tm-surface);
	color: var(--tm-text-2);
	cursor: pointer;
	line-height: 1.4;
	transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}
.tm-sec-btn:hover {
	background: var(--tm-surface-2);
	color: var(--tm-text-1);
	border-color: rgba(17, 24, 39, 0.18);
}
.tm-sec-btn:disabled {
	opacity: 0.4;
	cursor: default;
}
.tm-sec-btn-icon svg {
	width: 1em;
	height: 1em;
	vertical-align: -0.15em;
}
.tm-sec-btn--done {
	color: var(--tm-accent);
	border-color: var(--tm-accent);
	background: var(--tm-accent-soft);
}
.tm-sec-btn--done:hover { background: var(--tm-accent-soft); color: var(--tm-accent-strong); }
.tm-sec-btn--undo {
	color: var(--tm-accent);
	border-color: var(--tm-accent);
	background: var(--tm-accent-soft);
}
.tm-sec-btn--undo:hover { background: var(--tm-accent-soft); color: var(--tm-accent-strong); }
.tm-sec-btn--del {
	color: var(--tm-danger);
	border-color: var(--tm-danger-soft);
	background: var(--tm-danger-soft);
}
.tm-sec-btn--del:hover { background: #fecaca; color: var(--tm-danger); }
.tm-sec-btn--ignore {
	color: var(--tm-text-3);
}
.tm-bar-sep {
	width: 1px;
	height: 1.2em;
	background: <<colour muted-foreground>>;
	opacity: 0.4;
	margin: 0 4px;
	display: inline-block;
}
.tm-import-dup {
	color: <<colour danger>>;
	font-size: 0.9em;
	margin: 2px 0;
}
.tm-import-summary {
	margin-top: 6px;
	padding-top: 4px;
	border-top: 1px dotted <<colour muted-foreground>>;
}
mark.tm-readpoint {
	background: #fff3a0;
	box-shadow: 0 0 0 2px #fff3a0;
}
.tm-import-outline {
	margin: 2px 0 6px;
}
.tm-import-outline-pre {
	white-space: pre-wrap;
	max-height: 12em;
	overflow: auto;
	background: <<colour very-light-background>>;
	padding: 6px;
	border-radius: 4px;
}
/* G1 切分预览干预 */
.tm-split-list {
	margin: 4px 0;
	max-height: 22em;
	overflow: auto;
	border: 1px dotted <<colour muted-foreground>>;
	border-radius: 4px;
	padding: 4px 6px;
}
.tm-split-row {
	display: flex;
	align-items: center;
	gap: 0.5em;
	padding: 2px 0;
	flex-wrap: wrap;
	font-size: 0.92em;
	border-left: 2px solid <<colour muted-foreground>>;
	opacity: 0.9;
}
.tm-split-row-merged {
	background: var(--tm-mark-merged);
	border-left-color: #94a3b8;
}
.tm-split-row-cont {
	border-left-color: #f59e0b;
}
.tm-split-row-tuned {
	border-left-color: <<colour primary>>;
	background: var(--tm-mark-split);
}
.tm-split-mark {
	font-size: 0.8em;
	opacity: 0.6;
	min-width: 3.5em;
}
.tm-split-done {
	font-size: 0.8em;
	color: <<colour primary>>;
}
.tm-split-title {
	opacity: 0.9;
}
.tm-split-op {
	font-size: 0.85em;
	padding: 0 6px;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 3px;
	opacity: 0.8;
}
.tm-split-op:hover {
	opacity: 1;
}
.tm-doc-resume-row {
	margin: 4px 0;
}

/* 卡片浏览/管理器样式已迁移到 $:/plugins/keepone/tidme/manager（全局组件归属）；此处保留 doc-resume 使用的通用操作按钮类 */
.tm-cm-op {
	padding: 0 5px;
	font-size: 0.85em;
	opacity: 0.7;
}
.tm-cm-op:hover {
	opacity: 1;
}
.tm-cm-del:hover {
	color: <<colour danger>>;
}

/* 文档页已读区 / 聚合区（details 卡片） */
.tm-doc-done, .tm-doc-derived {
	margin: 8px 0;
	font-size: 0.9em;
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	background: var(--tm-surface);
	box-shadow: var(--tm-shadow-sm);
	overflow: hidden;
}
.tm-doc-done summary, .tm-doc-derived summary {
	cursor: pointer;
	padding: 10px 14px;
	background: var(--tm-surface-2);
	color: var(--tm-text-2);
	font-weight: 500;
	list-style: none;
}
.tm-doc-done summary::before, .tm-doc-derived summary::before { content: "▸"; margin-right: 8px; color: var(--tm-text-3); }
.tm-doc-done[open] summary, .tm-doc-derived[open] summary { border-bottom: 1px solid var(--tm-border); }
.tm-doc-done[open] summary::before, .tm-doc-derived[open] summary::before { transform: rotate(90deg); display: inline-block; }
/* 文档页聚合区/已读区：表格（列式紧凑，避免竖排拉长） */
.tm-doc-table {
	width: 100%;
	border-collapse: collapse;
	table-layout: fixed;
	font-size: 0.9em;
}
.tm-doc-table th {
	text-align: left;
	padding: 6px 12px;
	color: var(--tm-text-3);
	font-size: 0.72em;
	text-transform: uppercase;
	letter-spacing: 0.02em;
	font-weight: 600;
	border-bottom: 1px solid var(--tm-border);
}
.tm-doc-table td {
	padding: 5px 12px;
	border-bottom: 1px solid var(--tm-border);
	color: var(--tm-text-1);
	vertical-align: middle;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.tm-doc-table tbody tr:hover { background: var(--tm-surface-2); }
/* 已读区（名称弹性 / 操作固定右对齐） */
.tm-doc-done-table th:last-child, .tm-doc-done-table td:last-child { width: 130px; }
/* 摘录区（类型窄 / 名称弹性 / 加工窄 / 操作固定） */
.tm-doc-derived-table td:first-child, .tm-doc-derived-table th:first-child { width: 48px; }
.tm-doc-derived-table td:nth-child(3), .tm-doc-derived-table th:nth-child(3) { width: 80px; }
.tm-doc-derived-table td:nth-child(4), .tm-doc-derived-table th:nth-child(4) { width: 250px; }
.tm-cb-name { color: var(--tm-text-1); }
.tm-cb-actions { white-space: nowrap; text-align: right; }
.tm-cb-actions .tm-btn { margin-left: 4px; padding: 3px 10px; font-size: 0.84em; }
.tm-cb-del { color: var(--tm-text-2); }
.tm-cb-del:hover { color: var(--tm-danger); background: var(--tm-danger-soft); }
.tm-cb-kind {
	display: inline-flex;
	min-width: 1.7em;
	justify-content: center;
	font-size: 0.74em;
	border-radius: var(--tm-radius-sm);
	background: var(--tm-badge-new-bg);
	color: var(--tm-badge-new-fg);
	font-weight: 600;
	padding: 1px 4px;
}
.tm-doc-done-row {
	color: var(--tm-text-1);
}
.tm-doc-done-row:hover, .tm-doc-derived .tm-doc-done-row:hover { background: var(--tm-surface-2); }

/* M3 阅读态排版：Section 卡展开正文（与 section-bar 同帧时生效） */
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body {
	max-width: 42em;
	line-height: 1.8;
}
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body p {
	margin: 0.7em 0;
}
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body h1,
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body h2,
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body h3 {
	margin-top: 1.2em;
}

/* 嵌套摘录 / 回看锚点高亮 */
.tm-inline-anchor {
	background: #d8ecff;
	box-shadow: 0 0 0 2px #d8ecff;
}
/* ===== W2 阅读列表（topic 队列页，卡片化） ===== */
.tm-reading-list {
	display: flex;
	flex-direction: column;
	gap: var(--tm-gap-xl);
}
.tm-rl-head {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 12px;
	padding-bottom: 12px;
	border-bottom: 1px solid var(--tm-border);
	margin-bottom: 8px;
}
.tm-rl-title {
	font-size: 1.25em;
	font-weight: 700;
	letter-spacing: -0.01em;
	color: var(--tm-text-1);
}
.tm-rl-sub {
	font-size: 0.86em;
	color: var(--tm-text-2);
}
.tm-rl-deck-btn {
	margin-left: auto;
}

.tm-rl-doc {
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	background: var(--tm-surface);
	box-shadow: var(--tm-shadow);
	overflow: hidden;
	transition: var(--tm-transition);
}
.tm-rl-doc:hover {
	box-shadow: var(--tm-shadow-lg);
	border-color: hsl(245, 75%, 85%);
	transform: translateY(-2px);
}
.tm-rl-doc-head {
	display: flex;
	align-items: center;
	gap: 12px;
	padding: 14px 18px;
	background: var(--tm-surface-2);
	border-bottom: 1px solid var(--tm-border);
	list-style: none;
	cursor: pointer;
	transition: var(--tm-transition);
}
.tm-rl-doc-head:hover {
	background: var(--tm-surface-3);
}
.tm-rl-doc[open] > .tm-rl-doc-head { border-bottom: 1px solid var(--tm-border); }
.tm-rl-doc-head::-webkit-details-marker { display: none; }
.tm-rl-doc-head::before { content: "▸"; color: var(--tm-text-3); transition: transform 0.2s; flex: none; font-size: 1.1em; }
.tm-rl-doc[open] > .tm-rl-doc-head::before { transform: rotate(90deg); }
.tm-rl-doc-head > .tc-tiddlylink { flex: 1; min-width: 0; color: var(--tm-text-1); font-weight: 600; }
.tm-rl-doc-head > .tc-tiddlylink:hover { color: var(--tm-accent); }
.tm-rl-doc-count { font-size: 0.8em; color: var(--tm-text-2); white-space: nowrap; }
.tm-rl-doc-name { font-weight: 700; color: var(--tm-text-1); font-size: 1.02em; }
.tm-rl-doc-prog { font-size: 0.82em; color: var(--tm-text-2); white-space: nowrap; }
.tm-rl-doc-bar { flex: 0 0 90px; height: 6px; margin: 0 4px; }
.tm-rl-table { width: 100%; border-collapse: collapse; font-size: 0.9em; }
.tm-rl-table th {
	text-align: left;
	padding: 6px 12px;
	color: var(--tm-text-3);
	font-size: 0.74em;
	text-transform: uppercase;
	letter-spacing: 0.02em;
	font-weight: 600;
	border-bottom: 1px solid var(--tm-border);
}
.tm-rl-table td {
	padding: 5px 12px;
	border-bottom: 1px solid var(--tm-border);
	color: var(--tm-text-1);
	vertical-align: middle;
}
.tm-rl-table tbody tr:hover { background: var(--tm-surface-2); }
.tm-rl-kind {
	display: inline-flex;
	min-width: 1.7em;
	justify-content: center;
	font-size: 0.74em;
	border-radius: var(--tm-radius-sm);
	background: var(--tm-badge-new-bg);
	color: var(--tm-badge-new-fg);
	font-weight: 600;
	padding: 1px 4px;
}
.tm-rl-kind-extract { background: var(--tm-badge-due-bg); color: var(--tm-badge-due-fg); }
.tm-rl-title { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tm-rl-pri { font-size: 0.75em; color: var(--tm-text-3); font-variant-numeric: tabular-nums; }
.tm-rl-due {
	display: inline-block;
	font-size: 0.74em;
	padding: 0 8px;
	border-radius: 999px;
	font-weight: 600;
}
.tm-rl-row .tm-rl-due:empty { display: none; }

/* 侧边栏紧凑阅读列表 */
.tm-rl-compact .tm-rl-head { border-bottom: none; padding-bottom: 2px; }
.tm-rl-compact .tm-rl-title { font-size: 1em; }
.tm-rl-compact .tm-rl-doc-head { padding: 6px 8px; }
.tm-rl-compact .tm-rl-table { font-size: 0.82em; }
.tm-rl-compact .tm-rl-table th, .tm-rl-compact .tm-rl-table td { padding: 3px 8px; }


/* W3 摘录加工状态标注（文档页聚合区） */
.tm-cb-state {
	flex: none;
	font-size: 0.72em;
	padding: 0 6px;
	border-radius: var(--tm-radius);
	background: var(--tm-badge-new);
	opacity: 0.9;
}
.tm-cb-state-done { background: var(--tm-badge-due); }

/* ---- 仪表盘分栏网格 (Dashboard Grid Layout) ---- */
.tm-stats-grid {
	display: grid;
	grid-template-columns: 2fr 1fr;
	gap: 20px;
	margin-top: 20px;
}
.tm-stats-col-main {
	display: flex;
	flex-direction: column;
	gap: 18px;
}
.tm-stats-col-side {
	display: flex;
	flex-direction: column;
	gap: 18px;
}

@media (max-width: 768px) {
	.tm-stats-grid {
		grid-template-columns: 1fr;
	}
}

/* ---- 导入小部件容器与全页面拖拽覆盖层 (Uploader & Fullpage Drag Overlay) ---- */
.tm-import-widget {
	position: relative;
	width: 100%;
}
.tm-import-select-btn {
	display: block;
	width: 100%;
	padding: 14px 20px !important;
	font-size: 1.05em !important;
	font-weight: 600;
	border-radius: var(--tm-radius-sm) !important;
	text-align: center;
}
.tm-import-hint {
	font-size: 0.88em;
	color: var(--tm-text-3);
	text-align: center;
	margin: 10px 0 16px;
}
.tm-import-drag-overlay {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: rgba(99, 102, 241, 0.08);
	backdrop-filter: blur(4px);
	border: 2px dashed var(--tm-accent);
	border-radius: var(--tm-radius);
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--tm-accent-strong);
	font-size: 1.25em;
	font-weight: 700;
	z-index: 1000;
	pointer-events: none;
	transition: opacity 0.22s ease;
	text-align: center;
	padding: 20px;
}

/* ---- 粘贴文本 (Paste Split) & 收件箱 (Inbox Split) ---- */
.tm-paste-split {
	display: flex;
	flex-direction: column;
	gap: 12px;
}
.tm-paste-textarea {
	width: 100%;
	min-height: 180px;
	padding: 12px 14px;
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius-sm);
	background: var(--tm-surface-2);
	color: var(--tm-text-1);
	font-family: var(--tm-font);
	font-size: 0.95em;
	outline: none;
	resize: vertical;
	transition: var(--tm-transition);
}
.tm-paste-textarea:focus {
	border-color: var(--tm-accent);
	background: var(--tm-surface);
	box-shadow: 0 0 0 3px var(--tm-accent-soft);
}
.tm-paste-split .tm-import-muted {
	font-size: 0.88em;
	color: var(--tm-text-3);
	margin-top: 4px;
}

/* 剪藏收件箱 */
.tm-inbox-split {
	display: flex;
	flex-direction: column;
	gap: 12px;
}
.tm-inbox-split .tm-import-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 10px 14px;
	border-bottom: 1px solid var(--tm-border);
	transition: var(--tm-transition);
}
.tm-inbox-split .tm-import-row:hover {
	background: var(--tm-surface-2);
}
.tm-inbox-split .tm-import-row strong {
	font-weight: 600;
	color: var(--tm-text-1);
	font-size: 0.95em;
}
.tm-inbox-split .tm-import-row button {
	padding: 5px 12px !important;
	font-size: 0.85em !important;
	border-radius: var(--tm-radius-xs) !important;
}

/* 统一导入中心选项卡现代下划线式导航 */
.tm-import-tabs {
	display: flex;
	gap: 28px;
	margin: 16px 0 24px;
	padding-bottom: 0;
	border-bottom: 2px solid var(--tm-border);
}
.tm-import-tabs label.tm-import-tab {
	display: inline-flex;
	align-items: center;
	position: relative;
	font-size: 0.95em;
	font-weight: 600;
	color: var(--tm-text-2);
	padding: 8px 4px 12px;
	cursor: pointer;
	border: none !important;
	border-radius: 0 !important;
	background: transparent !important;
	border-bottom: 2px solid transparent !important;
	margin-bottom: -2px;
	transition: var(--tm-transition);
	box-shadow: none !important;
}
.tm-import-tabs label.tm-import-tab input[type="radio"] {
	display: none !important;
}
.tm-import-tabs label.tm-import-tab:hover {
	color: var(--tm-accent) !important;
}
.tm-import-tabs label.tm-import-tab.tm-tab--active,
.tm-import-tabs label.tm-import-tab.tc-radio-selected {
	color: var(--tm-accent) !important;
	border-bottom: 2px solid var(--tm-accent) !important;
	font-weight: 700;
}

/* AI 切分配置面板与大纲编辑器 */
.tm-ai-config-panel {
	margin: 8px 0 12px;
	border: 1px dashed var(--tm-accent);
	border-radius: var(--tm-radius);
	padding: 6px 12px;
	background: var(--tm-surface-2);
}
.tm-ai-config-summary {
	cursor: pointer;
	font-weight: 600;
	color: var(--tm-accent);
}
.tm-ai-config-body {
	margin-top: 8px;
	display: flex;
	flex-direction: column;
	gap: 6px;
}
.tm-ai-inputs-row {
	display: flex;
	gap: 6px;
	flex-wrap: wrap;
}
.tm-ai-inputs-row .tm-input {
	flex: 1;
	min-width: 140px;
}
.tm-split-row-renamed {
	border-left: 3px solid var(--tm-accent) !important;
}
.tm-split-row-deleted {
	opacity: 0.45;
	text-decoration: line-through;
	background: var(--tm-surface-2);
}
.tm-split-title-input {
	font-size: 0.9em;
	padding: 2px 6px;
	border: 1px solid var(--tm-accent);
	border-radius: 4px;
	background: var(--tm-surface);
	color: var(--tm-text-1);
}
.tm-split-add-form {
	margin: 6px 0 6px 20px;
	padding: 8px;
	border: 1px solid var(--tm-border);
	border-radius: var(--tm-radius);
	background: var(--tm-surface-2);
	display: flex;
	flex-direction: column;
	gap: 6px;
}
.tm-split-chars-warn {
	background: #ffe8cc !important;
	color: #d97706 !important;
	font-weight: 600;
}


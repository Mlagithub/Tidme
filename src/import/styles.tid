title: $:/plugins/tidme/import/styles
tags: $:/tags/Stylesheet

.tm-import-panel {
	margin-top: 0.5em;
}
.tm-import-dropzone {
	border: 2px dashed <<colour muted-foreground>>;
	border-radius: 6px;
	padding: 1.5em;
	text-align: center;
	cursor: pointer;
	margin: 0.5em 0;
	color: <<colour muted-foreground>>;
}
.tm-import-dropzone.tm-import-over {
	border-color: <<colour primary>>;
	color: <<colour primary>>;
	background: <<colour very-light-background>>;
}
.tm-import-row {
	padding: 0.25em 0;
}
.tm-import-error {
	color: <<colour danger>>;
}
.tm-import-muted {
	opacity: 0.7;
	font-size: 0.9em;
}
.tm-import-actions {
	display: flex;
	gap: 0.5em;
	margin-top: 0.5em;
}
.tm-section-bar {
	display: flex;
	flex-direction: column;
	gap: 2px;
	padding: 2px 0;
	margin-bottom: 4px;
	border-bottom: 1px dotted <<colour muted-foreground>>;
	font-size: 0.92em;
}
.tm-section-row {
	display: flex;
	align-items: center;
	gap: 0.5em;
	flex-wrap: wrap;
}
.tm-section-crumb {
	cursor: pointer;
}
.tm-section-pos {
	opacity: 0.75;
}
.tm-section-load {
	opacity: 0.75;
}
.tm-section-state {
	color: <<colour primary>>;
	opacity: 0.9;
}
/* 统一按钮风格：全部 tm-sec-btn 基类 + 语义修饰 */
.tm-sec-btn {
	font-size: 0.9em;
	padding: 1px 8px;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 3px;
	background: <<colour background>>;
	color: inherit;
	opacity: 0.85;
	cursor: pointer;
	line-height: 1.5;
}
.tm-sec-btn:hover {
	opacity: 1;
}
.tm-sec-btn:disabled {
	opacity: 0.4;
	cursor: default;
}
.tm-sec-btn--done {
	color: <<colour primary>>;
	border-color: <<colour primary>>;
}
.tm-sec-btn--undo {
	color: <<colour primary>>;
	border-color: <<colour primary>>;
}
.tm-sec-btn--del {
	color: <<colour danger>>;
	border-color: <<colour danger>>;
	opacity: 0.8;
}
.tm-sec-btn--ignore {
	opacity: 0.6;
}
.tm-bar-sep {
	width: 1px;
	height: 1.2em;
	background: <<colour muted-foreground>>;
	opacity: 0.4;
	margin: 0 4px;
	display: inline-block;
}
.tm-import-dup {
	color: <<colour danger>>;
	font-size: 0.9em;
	margin: 2px 0;
}
.tm-import-summary {
	margin-top: 6px;
	padding-top: 4px;
	border-top: 1px dotted <<colour muted-foreground>>;
}
mark.tm-readpoint {
	background: #fff3a0;
	box-shadow: 0 0 0 2px #fff3a0;
}
.tm-import-outline {
	margin: 2px 0 6px;
}
.tm-import-outline-pre {
	white-space: pre-wrap;
	max-height: 12em;
	overflow: auto;
	background: <<colour very-light-background>>;
	padding: 6px;
	border-radius: 4px;
}
/* G1 切分预览干预 */
.tm-split-list {
	margin: 4px 0;
	max-height: 22em;
	overflow: auto;
	border: 1px dotted <<colour muted-foreground>>;
	border-radius: 4px;
	padding: 4px 6px;
}
.tm-split-row {
	display: flex;
	align-items: center;
	gap: 0.5em;
	padding: 2px 0;
	flex-wrap: wrap;
	font-size: 0.92em;
}
.tm-split-row-merged {
	background: <<colour very-light-background>>;
	border-radius: 3px;
}
.tm-split-mark {
	font-size: 0.8em;
	opacity: 0.6;
	min-width: 3.5em;
}
.tm-split-done {
	font-size: 0.8em;
	color: <<colour primary>>;
}
.tm-split-title {
	opacity: 0.9;
}
.tm-split-op {
	font-size: 0.85em;
	padding: 0 6px;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 3px;
	opacity: 0.8;
}
.tm-split-op:hover {
	opacity: 1;
}
.tm-doc-resume-row {
	margin: 4px 0;
}

/* 卡片浏览（侧边栏树形） */
.tm-card-browser details {
	margin-left: 0.4em;
}
.tm-card-browser summary {
	cursor: pointer;
}
.tm-cb-deck {
	margin-top: 0.4em;
}
.tm-cb-doc {
	margin-left: 0.6em;
}
.tm-cb-doc-title {
	opacity: 0.85;
	font-size: 0.95em;
}
.tm-cb-card {
	display: flex;
	align-items: center;
	gap: 0.3em;
	font-size: 0.9em;
	padding: 1px 0;
}
.tm-cb-badge {
	font-size: 0.85em;
	opacity: 0.8;
	min-width: 1.2em;
}
.tm-cb-kind {
	font-size: 0.8em;
	opacity: 0.6;
}
.tm-cb-link {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	max-width: 16em;
}
.tm-cb-del {
	opacity: 0.4;
	padding: 0 4px;
}
.tm-cb-del:hover {
	opacity: 1;
}

/* 卡片管理器 */
.tm-card-manager {
	font-size: 0.95em;
}
.tm-cm-views {
	display: flex;
	gap: 0.4em;
	flex-wrap: wrap;
	margin-bottom: 0.3em;
}
.tm-cm-view {
	padding: 2px 10px;
	border-radius: 4px;
	border: 1px solid <<colour muted-foreground>>;
	opacity: 0.85;
}
.tm-cm-view-active {
	background: <<colour primary>>;
	color: <<colour background>>;
	opacity: 1;
}
.tm-cm-orgs {
	display: flex;
	gap: 0.4em;
	flex-wrap: wrap;
	margin-bottom: 0.3em;
}
.tm-cm-org {
	padding: 1px 8px;
	border-radius: 3px;
	border: 1px dashed <<colour muted-foreground>>;
	opacity: 0.75;
	font-size: 0.9em;
}
.tm-cm-org:hover {
	opacity: 1;
}
.tm-cm-org-active {
	border-style: solid;
	border-color: <<colour primary>>;
	color: <<colour primary>>;
	opacity: 1;
}
.tm-cm-bar {
	display: flex;
	gap: 0.4em;
	flex-wrap: wrap;
	align-items: center;
	margin-bottom: 0.5em;
	padding: 4px 0;
	border-top: 1px dotted <<colour muted-foreground>>;
	border-bottom: 1px dotted <<colour muted-foreground>>;
}
.tm-cm-bar button {
	padding: 1px 8px;
	font-size: 0.9em;
}
.tm-cm-tree details {
	margin-left: 0.4em;
}
.tm-cm-tree summary {
	cursor: pointer;
}
.tm-cm-deck {
	margin-top: 0.4em;
}
.tm-cm-doc {
	margin-left: 0.6em;
}
.tm-cm-doc-title {
	opacity: 0.85;
	font-size: 0.95em;
}
.tm-cm-card {
	display: flex;
	align-items: center;
	gap: 0.35em;
	padding: 2px 0;
}
.tm-cm-head {
	border-bottom: 1px dotted <<colour muted-foreground>>;
	margin-bottom: 2px;
	font-size: 0.85em;
	opacity: 0.8;
}
.tm-cm-head-cell {
	min-width: 2em;
}
.tm-cm-sort {
	padding: 0 4px;
	font-size: 0.9em;
	border-radius: 3px;
	border: 1px solid transparent;
}
.tm-cm-sort:hover {
	border-color: <<colour muted-foreground>>;
}
.tm-cm-sort-active {
	border-color: <<colour primary>>;
	color: <<colour primary>>;
}
.tm-cm-listrow {
	font-size: 0.9em;
}
.tm-cm-col-deck {
	font-size: 0.8em;
	opacity: 0.6;
	min-width: 6em;
	max-width: 10em;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.tm-cm-col-due {
	font-size: 0.8em;
	opacity: 0.6;
	min-width: 5em;
}
.tm-cm-preview {
	margin: 6px 0 2px;
	padding: 6px 8px;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 4px;
	background: <<colour very-light-background>>;
}
.tm-cm-preview-head {
	font-size: 0.85em;
	opacity: 0.8;
	margin-bottom: 3px;
}
.tm-cm-preview-body {
	font-size: 0.9em;
	max-height: 10em;
	overflow: auto;
	white-space: pre-wrap;
}
.tm-cm-orphan summary strong {
	opacity: 0.65;
	font-style: italic;
}
.tm-cm-badge {
	font-size: 0.85em;
	min-width: 1.3em;
	text-align: center;
	border-radius: 3px;
	padding: 0 2px;
}
.tm-badge-new { background: #dbeafe; }
.tm-badge-learn { background: #fef3c7; }
.tm-badge-due { background: #d1fae5; }
.tm-badge-overdue { background: #fee2e2; }
.tm-badge-done { background: #e5e7eb; opacity: 0.8; }
.tm-badge-suspended { background: #ede9fe; }
.tm-cm-kind {
	font-size: 0.8em;
	opacity: 0.6;
}
.tm-cm-pri {
	font-size: 0.75em;
	opacity: 0.5;
}
.tm-cm-link {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	max-width: 18em;
}
.tm-cm-op {
	padding: 0 5px;
	font-size: 0.85em;
	opacity: 0.7;
}
.tm-cm-op:hover {
	opacity: 1;
}
.tm-cm-del:hover {
	color: <<colour danger>>;
}

/* 文档页已读区 */
.tm-doc-done {
	margin: 4px 0;
	font-size: 0.9em;
}
.tm-doc-done summary {
	cursor: pointer;
	opacity: 0.8;
}
.tm-doc-done-row {
	display: flex;
	align-items: center;
	gap: 0.5em;
	padding: 1px 0;
}
.tm-doc-derived {
	margin: 4px 0;
	font-size: 0.9em;
}
.tm-doc-derived summary {
	cursor: pointer;
	opacity: 0.8;
}

/* M3 阅读态排版：Section 卡展开正文（与 section-bar 同帧时生效） */
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body {
	max-width: 42em;
	line-height: 1.8;
}
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body p {
	margin: 0.7em 0;
}
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body h1,
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body h2,
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body h3 {
	margin-top: 1.2em;
}

/* 嵌套摘录 / 回看锚点高亮 */
.tm-inline-anchor {
	background: #d8ecff;
	box-shadow: 0 0 0 2px #d8ecff;
}

title: $:/plugins/tidme/import/styles
tags: $:/tags/Stylesheet

/* ===== P0 设计 token（与 Tidme Manager 一致的语义色/尺寸） ===== */
:root {
	--tm-radius: 4px;
	--tm-gap: 4px;
	--tm-gap-lg: 8px;
	--tm-badge-new: #dbeafe;
	--tm-badge-learn: #fef3c7;
	--tm-badge-due: #d1fae5;
	--tm-badge-overdue: #fee2e2;
	--tm-badge-done: #e5e7eb;
	--tm-badge-suspended: #ede9fe;
	--tm-mark-merged: #f1f5f9;
	--tm-mark-split: #eff6ff;
}

/* ===== 按钮体系（次操作统一 tm-btn；主操作沿用 tc-btn-primary） ===== */
.tm-btn {
	display: inline-flex;
	align-items: center;
	gap: 0.35em;
	font-size: 0.9em;
	padding: 2px 10px;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: var(--tm-radius);
	background: <<colour background>>;
	color: inherit;
	opacity: 0.85;
	cursor: pointer;
	line-height: 1.5;
}
.tm-btn:hover { opacity: 1; }
.tm-btn:disabled { opacity: 0.4; cursor: default; }
.tm-btn--primary { border-color: <<colour primary>>; color: <<colour primary>>; }
.tm-btn--danger { border-color: <<colour danger>>; color: <<colour danger>>; }
.tm-btn--active {
	background: <<colour primary>>;
	color: <<colour background>>;
	border-color: <<colour primary>>;
	opacity: 1;
}
.tm-btn-icon { padding: 2px 6px; }
.tm-btn-icon img, .tm-btn-icon svg { width: 1em; height: 1em; vertical-align: -0.15em; }

/* ===== 空状态 ===== */
.tm-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--tm-gap);
	padding: 18px 8px;
	color: <<colour muted-foreground>>;
	font-size: 0.9em;
	text-align: center;
}
.tm-empty-icon { font-size: 1.8em; opacity: 0.45; line-height: 1; }

/* ===== Toast 反馈 ===== */
.tm-toast {
	padding: 6px 12px;
	border-radius: var(--tm-radius);
	border: 1px solid <<colour muted-foreground>>;
	background: <<colour background>>;
	font-size: 0.9em;
	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
}
.tm-toast--ok { border-color: #22c55e; color: #15803d; }
.tm-toast--err { border-color: <<colour danger>>; color: <<colour danger>>; }

.tm-import-panel {
	margin-top: 0.5em;
}
.tm-import-dropzone {
	border: 2px dashed <<colour muted-foreground>>;
	border-radius: 6px;
	padding: 1.5em;
	text-align: center;
	cursor: pointer;
	margin: 0.5em 0;
	color: <<colour muted-foreground>>;
}
.tm-import-dropzone.tm-import-over {
	border-color: <<colour primary>>;
	color: <<colour primary>>;
	background: <<colour very-light-background>>;
}
.tm-import-row {
	padding: 0.25em 0;
}
.tm-import-error {
	color: <<colour danger>>;
}
.tm-import-muted {
	opacity: 0.7;
	font-size: 0.9em;
}
.tm-import-actions {
	display: flex;
	gap: 0.5em;
	margin-top: 0.5em;
}
/* G10 服务端后台处理选项 */
.tm-import-server-row {
	display: flex;
	align-items: center;
	gap: 0.4em;
	margin: 6px 0 2px;
	font-size: 0.92em;
}
.tm-section-bar {
	display: flex;
	flex-direction: column;
	gap: 2px;
	padding: 2px 0;
	margin-bottom: 4px;
	border-bottom: 1px dotted <<colour muted-foreground>>;
	font-size: 0.92em;
}
.tm-section-row {
	display: flex;
	align-items: center;
	gap: 0.5em;
	flex-wrap: wrap;
}
.tm-section-crumb {
	cursor: pointer;
}
.tm-section-pos {
	opacity: 0.75;
}
.tm-section-load {
	opacity: 0.75;
}
.tm-section-state {
	color: <<colour primary>>;
	opacity: 0.9;
}
/* 统一按钮风格：全部 tm-sec-btn 基类 + 语义修饰 */
.tm-sec-btn {
	font-size: 0.9em;
	padding: 1px 8px;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 3px;
	background: <<colour background>>;
	color: inherit;
	opacity: 0.85;
	cursor: pointer;
	line-height: 1.5;
}
.tm-sec-btn:hover {
	opacity: 1;
}
.tm-sec-btn:disabled {
	opacity: 0.4;
	cursor: default;
}
.tm-sec-btn--done {
	color: <<colour primary>>;
	border-color: <<colour primary>>;
}
.tm-sec-btn--undo {
	color: <<colour primary>>;
	border-color: <<colour primary>>;
}
.tm-sec-btn--del {
	color: <<colour danger>>;
	border-color: <<colour danger>>;
	opacity: 0.8;
}
.tm-sec-btn--ignore {
	opacity: 0.6;
}
.tm-bar-sep {
	width: 1px;
	height: 1.2em;
	background: <<colour muted-foreground>>;
	opacity: 0.4;
	margin: 0 4px;
	display: inline-block;
}
.tm-import-dup {
	color: <<colour danger>>;
	font-size: 0.9em;
	margin: 2px 0;
}
.tm-import-summary {
	margin-top: 6px;
	padding-top: 4px;
	border-top: 1px dotted <<colour muted-foreground>>;
}
mark.tm-readpoint {
	background: #fff3a0;
	box-shadow: 0 0 0 2px #fff3a0;
}
.tm-import-outline {
	margin: 2px 0 6px;
}
.tm-import-outline-pre {
	white-space: pre-wrap;
	max-height: 12em;
	overflow: auto;
	background: <<colour very-light-background>>;
	padding: 6px;
	border-radius: 4px;
}
/* G1 切分预览干预 */
.tm-split-list {
	margin: 4px 0;
	max-height: 22em;
	overflow: auto;
	border: 1px dotted <<colour muted-foreground>>;
	border-radius: 4px;
	padding: 4px 6px;
}
.tm-split-row {
	display: flex;
	align-items: center;
	gap: 0.5em;
	padding: 2px 0;
	flex-wrap: wrap;
	font-size: 0.92em;
}
.tm-split-row-merged {
	background: <<colour very-light-background>>;
	border-radius: 3px;
}
.tm-split-mark {
	font-size: 0.8em;
	opacity: 0.6;
	min-width: 3.5em;
}
.tm-split-done {
	font-size: 0.8em;
	color: <<colour primary>>;
}
.tm-split-title {
	opacity: 0.9;
}
.tm-split-op {
	font-size: 0.85em;
	padding: 0 6px;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 3px;
	opacity: 0.8;
}
.tm-split-op:hover {
	opacity: 1;
}
.tm-doc-resume-row {
	margin: 4px 0;
}

/* 卡片浏览/管理器样式已迁移到 $:/plugins/tidme/manager（全局组件归属）；此处保留 doc-resume 使用的通用操作按钮类 */
.tm-cm-op {
	padding: 0 5px;
	font-size: 0.85em;
	opacity: 0.7;
}
.tm-cm-op:hover {
	opacity: 1;
}
.tm-cm-del:hover {
	color: <<colour danger>>;
}

/* 文档页已读区 */
.tm-doc-done {
	margin: 4px 0;
	font-size: 0.9em;
}
.tm-doc-done summary {
	cursor: pointer;
	opacity: 0.8;
}
.tm-doc-done-row {
	display: flex;
	align-items: center;
	gap: 0.5em;
	padding: 1px 0;
}
.tm-doc-derived {
	margin: 4px 0;
	font-size: 0.9em;
}
.tm-doc-derived summary {
	cursor: pointer;
	opacity: 0.8;
}

/* M3 阅读态排版：Section 卡展开正文（与 section-bar 同帧时生效） */
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body {
	max-width: 42em;
	line-height: 1.8;
}
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body p {
	margin: 0.7em 0;
}
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body h1,
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body h2,
.tc-tiddler-frame:has(.tm-section-bar) .tc-tiddler-body h3 {
	margin-top: 1.2em;
}

/* 嵌套摘录 / 回看锚点高亮 */
.tm-inline-anchor {
	background: #d8ecff;
	box-shadow: 0 0 0 2px #d8ecff;
}

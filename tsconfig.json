{
  "extends": "@modern-js/tsconfig/base.json",
  "compilerOptions": {
    "declaration": false,
    "jsx": "react-jsx",
    "baseUrl": "./",
    "typeRoots" : ["node_modules/@types", "node_modules/tw5-typed"],
    "lib": ["DOM", "ESNext"],
    "allowImportingTsExtensions": true,
    "paths": {
      "$:/plugins/tidme/core/*": ["src/core/*"]
    }
  },
  "include": ["src"],
  "exclude": ["./**/*.js"]
}

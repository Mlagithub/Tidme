{
  "name": "tidme",
  "version": "1.18.0",
  "description": "Lifelong knowledge, deep in mind. Incremental reading & FSRS spaced repetition for TiddlyWiki 5.",
  "scripts": {
    "build": "node tools/build-plugins.cjs",
    "build:plugins": "node tools/build-plugins.cjs",
    "build:plugins:dev": "node tools/build-plugins.cjs --dev",
    "build:fixture": "node tools/make-fixture.mjs tools/fixtures/demo.epub",
    "dev": "tiddlywiki-plugin-dev dev",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rimraf dist",
    "semantic-release": "semantic-release",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keepone/Tidme.git"
  },
  "keywords": [
    "tiddlywiki",
    "tiddlywiki5",
    "tiddlywiki-plugin",
    "incremental-learning",
    "incremental-reading",
    "fsrs",
    "flashcards",
    "spaced-repetition",
    "active-recall",
    "anki",
    "supermemo"
  ],
  "author": "keepone",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs,json,md}": "dprint fmt --allow-no-files"
  },
  "bugs": {
    "url": "https://github.com/keepone/Tidme/issues"
  },
  "homepage": "https://github.com/keepone/Tidme#readme",
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "codemirror": "^6.0.2",
    "fsrs.js": "1.2.0",
    "tiddlywiki": "5.3.3"
  },
  "devDependencies": {
    "@modern-js/tsconfig": "^2.43.0",
    "@semantic-release/changelog": "latest",
    "@semantic-release/git": "latest",
    "@types/node": "^20.10.5",
    "dprint": "^0.44.0",
    "husky": "^8.0.3",
    "jsdom": "^24.1.3",
    "jszip": "^3.10.1",
    "lint-staged": "^15.2.0",
    "npm-check-updates": "^16.14.12",
    "pdfjs-dist": "^3.11.174",
    "postcss": "^8.4.32",
    "rimraf": "^5.0.5",
    "semantic-release": "latest",
    "tiddlywiki-plugin-dev": "^0.0.39",
    "ts-node": "^10.9.2",
    "tw5-typed": "^0.4.0",
    "typescript": "^5.3.3"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "bin/$__plugins_keepone_tidme.json",
              "label": "Tidme Plugin JSON"
            },
            {
              "path": "bin/$__tidme_languages_zh-Hans.json",
              "label": "Tidme zh-Hans Language Pack"
            }
          ]
        }
      ]
    ]
  }
}
